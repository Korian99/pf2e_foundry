  "offensiveAbilities": [
    {
      "name": "Consume Light",
      "actions": 0,
      "traits": [
        "darkness",
        "occult"
      ],
      "description": "<p><strong>Trigger</strong> The voidglutton casts Darkness</p>\n<hr />\n<p><strong>Effect</strong> The voidglutton extinguishes its Glow as part of Casting the Spell. It becomes Invisible as long as it remains in the area of darkness. If the voidglutton uses a hostile action, its invisibility ends as soon as the hostile action is completed.</p>",
      "collapsed": false
    },
    {
      "name": "Ectoplasmic Web Trap",
      "actions": null,
      "traits": [
        "occult"
      ],
      "description": "<p>A creature hit by the voidglutton's ectoplasmic web trap is Immobilized and stuck to the nearest surface until it succeeds at a DC 26 check to Escape dc=26. Ectoplasmic Web Trap can immobilize incorporeal creatures.</p>",
      "collapsed": false
    },
    {
      "name": "Fearful Strike",
      "actions": null,
      "traits": [
        "emotion",
        "fear",
        "mental",
        "occult"
      ],
      "description": "<p>When the voidglutton damages a creature with its claw Strike, the creature must succeed at a DC 26 Will Saving Throw save or become Frightened 1 (Frightened 2 on a critical failure).</p>",
      "collapsed": false
    },
    {
      "name": "Feed on Fear",
      "actions": 1,
      "traits": [
        "concentrate"
      ],
      "description": "<p><strong>Frequency</strong> once per round</p>\n<p><strong>Requirement</strong> An enemy is affected by a fear effect or has the frightened or dying condition, and is within 25 feet of the voidglutton</p>\n<hr />\n<p><strong>Effect</strong> The voidglutton feeds on the creature's terror. It regains 3d4 Healing Damage Hit Points and its Glow reignites if it had been extinguished.</p>\n<p>It cannot use Consume Light again for 1d4 rounds, as it is too glutted on fear to suppress its Glow.</p>",
      "collapsed": false
    },
    {
      "name": "Magic Immunity",
      "actions": null,
      "traits": [],
      "description": "<p>A voidglutton is immune to all spells except Faerie Fire, Revealing Light, Force Barrage, Quandary, and spells with the light trait.</p>",
      "collapsed": false
    }
  ],
