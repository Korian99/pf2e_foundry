  "offensiveAbilities": [
    {
      "name": "Breath Pollen",
      "actions": 2,
      "traits": [
        "arcane",
        "plant"
      ],
      "description": "<p>The wood scamp breathes choking pollen in a 15ft Cone that deals 2d6 Poison Damage damage to each creature within the area (Basic DC 17 Reflex Saving Throw; creatures who don't need to breathe are immune). The wood scamp can't use Breathe Pollen again for 1d4 rounds.</p>",
      "collapsed": false
    },
    {
      "name": "Thorn Puncture",
      "actions": null,
      "traits": [],
      "description": "<p>The wood scamp breaks off one of its thornlike claws in the target's skin, dealing 1 Bleed Damage{1 persistent bleed} damage until the thorn is removed, which requires an Interact action. This damage is cumulative with each thorn caught in a creature's skin.</p>",
      "collapsed": false
    }
  ],
