    {
      "name": "Divert Power",
      "actions": 1,
      "traits": [],
      "description": "<p>The robot diverts additional power from one of its weapon arrays to another. Choose one of the following effects, which lasts until the end of the robot's turn.</p>\n<ul>\n<li>The robot's fist Strike deals an additional 1d4 Electricity Damage damage. The damage of its laser beam Strike decreases to 1d4 Fire Damage.</li>\n<li>The robot's laser beam Strike deals an additional 1d4 Fire Damage damage. The damage of its fist Strike decreases to (1d4+2) Bludgeoning Damage damage.</li>\n</ul>",
      "collapsed": false
    },
    {
