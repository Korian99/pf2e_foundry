  "offensiveAbilities": [
    {
      "name": "Flying Strafe",
      "actions": 2,
      "traits": [],
      "description": "<p>The elder shantak Flies up to their fly speed and makes two claw Strikes at any point during it's movement. Each Strike must target a different creature. The attacks take the normal multiple attack penalty.</p>",
      "collapsed": false
    },
    {
      "name": "Screech",
      "actions": 1,
      "traits": [
        "incapacitation",
        "occult",
        "sonic"
      ],
      "description": "<p>The shantak's screech deals 15d6 Sonic Damage damage in a 50ft Type:cone (Basic DC 33 Fortitude Saving Throw save). A creature that fails the save is also Stunned 1 (Stunned 3 on a critical failure). The shantak can't use Screech again for 1d4 rounds.</p>",
      "collapsed": false
    },
    {
      "name": "Share Defenses",
      "actions": 0,
      "traits": [
        "occult"
      ],
      "description": "<p><strong>Trigger</strong> A creature is riding the shantak</p><hr /><p><strong>Effect</strong> The shantak extends their no breath ability and cold resistance to a single creature riding them. They can withdraw this protection as a free action.</p>\n<p>Effect: Share Defenses</p>",
      "collapsed": false
    }
