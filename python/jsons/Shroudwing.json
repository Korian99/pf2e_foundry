  "offensiveAbilities": [
    {
      "name": "Death Rattle",
      "actions": 1,
      "traits": [
        "concentrate",
        "emotion",
        "fear",
        "mental"
      ],
      "description": "<p>The shroudwing emits a guttural, haunting call that instills a sense of fear almost impossible to shake. Each non-shroudwing creature within a 30ft Type:emanation must attempt a DC 18 Will Saving Throw save. Regardless of the result, creatures are then temporarily immune to Death Rattle for 1 minute.</p><hr /><p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature is Off-Guard until the start of the shroudwing's next turn.</p>\n<p><strong>Failure</strong> The creature is Frightened 1.</p>\n<p><strong>Critical Failure</strong> The creature is Frightened 2.</p>",
      "collapsed": false
    },
    {
      "name": "Grave Blight",
      "actions": null,
      "traits": [
        "disease"
      ],
      "description": "<p><strong>Saving Throw</strong> DC 18 Fortitude Saving Throw</p>\n<p><strong>Stage 1</strong> carrier with no ill effect (1 day)</p>\n<p><strong>Stage 2</strong> 1d6 Persistent,poison Damage damage every hour, Sickened 1, and can't reduce the value of the sickened condition while taking persistent poison damage (1 day)</p>\n<p><strong>Stage 3</strong> 2d6 Persistent,poison Damage damage every hour, Sickened 2, and can't reduce the value of the sickened condition while taking persistent poison damage (1 day)</p>",
      "collapsed": false
    },
    {
      "name": "Soul Feeding",
      "actions": 2,
      "traits": [
        "concentrate",
        "death",
        "divine",
        "manipulate"
      ],
      "description": "<p><strong>Requirements</strong> The shroudwing is adjacent to a dying creature</p><hr /><p><strong>Effect</strong> The shroudwing attempts to devour the dying creature's soul. The creature must attempt a DC 18 Will Saving Throw save or their dying condition increases by 1 and the shroudwing regains 2d8 Healing Damage Hit Points.</p>",
      "collapsed": false
    }
