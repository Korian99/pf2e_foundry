  "offensiveAbilities": [
    {
      "name": "Draconic Frenzy",
      "actions": 2,
      "traits": [],
      "description": "<p>The dragon makes two claw Strikes and one tail Strike in any order.</p>",
      "collapsed": false
    },
    {
      "name": "Draconic Momentum",
      "actions": null,
      "traits": [],
      "description": "<p>The dragon recharges their Resounding Roar whenever they score a critical hit with a Strike.</p>",
      "collapsed": false
    },
    {
      "name": "Eerie Call",
      "actions": 2,
      "traits": [
        "arcane",
        "auditory",
        "emotion",
        "fear",
        "mental"
      ],
      "description": "<p><strong>Requirements</strong> The dragon is Hidden or undetected</p><hr /><p><strong>Effect</strong> The dragon's wail draws in unsuspecting opponents. Anyone that can hear the Eerie Call must attempt a DC 24 Will Saving Throw save or become Fascinated by the sound. A fascinated creature must spend at least 1 action Seeking the dragon each turn, and the dragon can Sustain this affect for up to 1 minute</p>",
      "collapsed": false
    },
    {
      "name": "Natural Mimic",
      "actions": null,
      "traits": [],
      "description": "<p>The dragon can imitate any sound or voice that it has heard. This has the effect of 2nd-rank Ventriloquism (DC 24) but is a nonmagical effect.</p>",
      "collapsed": false
    },
    {
      "name": "Resounding Roar",
      "actions": 2,
      "traits": [
        "arcane",
        "sonic"
      ],
      "description": "<p>The dragon unleashes a thunderous call that deals 7d6 Sonic Damage damage in a 30ft Type:cone (Basic DC 24 Fortitude Saving Throw save). On a critical failure, a creature is also Deafened for 1 minute. The dragon can't use Resounding Roar again for 1d4 rounds.</p>",
      "collapsed": false
    }
  ],
