    {
      "name": "Drain Blood",
      "actions": 1,
      "traits": [],
      "description": "<p><strong>Requirements</strong> The sabosan has a creature Grabbed or Restrained</p><hr /><p><strong>Effect</strong> The sabosan drains blood from the creature. The creature must succeed at a DC 22 Fortitude Saving Throw save or become Drained 1. The sabosan gains a number of temporary Hit Points equal to the number of Hit Points lost by the creature due to its drained condition.</p>",
      "collapsed": false
    },
    {
