      "actions": -1,
      "traits": [
        "arcane",
        "cold"
      ],
      "description": "<p><strong>Trigger</strong> An adjacent creature deals piercing or slashing damage to the wyrmling</p><hr /><p><strong>Effect</strong> The wyrmling's blood splatters onto the triggering creature, dealing 1d4 Cold Damage damage. A creature that takes cold damage in this way is Slowed 1 for 1 round.</p>",
      "collapsed": false
