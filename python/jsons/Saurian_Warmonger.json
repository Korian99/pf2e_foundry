  "offensiveAbilities": [
    {
      "name": "Boneshaking Roar",
      "actions": 2,
      "traits": [
        "incapacitation",
        "sonic"
      ],
      "description": "<p>The saurian warmonger bellows, evoking the power of the primordial world.</p>\n<p>Non-dinosaur creatures within 30 feet take 10d6 Sonic Damage damage (Basic DC 34 Fortitude Saving Throw save). On a failed save, a creature is also Slowed 2 for 1 round (Stunned 1d4 on a critical failure).</p>\n<p>The saurian can't use Boneshaking Roar again for 1d4 rounds.</p>",
      "collapsed": false
    },
    {
      "name": "Primordial Balance",
      "actions": null,
      "traits": [],
      "description": "<p>A warmonger wields their <em>mancatcher</em> in one hand.</p>",
      "collapsed": false
    },
    {
      "name": "Restrain",
      "actions": null,
      "traits": [],
      "description": "<p>When the warmonger makes a successful mancatcher Strike, their target must succeed at a DC 34 Reflex Saving Throw save or become Grabbed until the end of the warmonger's next turn.</p>\n<p>Each time the creature fails an attempt to Escape the warmonger, it takes 2d6 Piercing Damage damage.</p>",
      "collapsed": false
    },
    {
      "name": "Three-Limbed Lunge",
      "actions": 1,
      "traits": [],
      "description": "<p>The saurian warmonger makes three Strikes: one Strike each with the weapons in their hands and one Strike with their tail. They can perform these attacks in any order, though each counts toward their multiple attack penalty as normal.</p>\n<p>After making a Three-Limbed Lunge, the warmonger is Off-Guard until the beginning of their next turn.</p>",
      "collapsed": false
    },
    {
      "name": "Grab",
      "actions": 1,
      "traits": [],
      "description": "<p><details><summary>See rules...</summary>\n<p><p><strong>Requirements</strong> The monster's last action was a successful Strike that lists Grab in its damage entry, or the monster has a creature Grabbed or Restrained</p><hr /><p><strong>Effect</strong> If used after a Strike, the monster attempts to Grapple the creature using the body part it attacked with. This attempt neither applies nor counts toward the creature's multiple attack penalty.</p><p>The monster can instead use Grab and choose one creature it's grabbing or restraining with an appendage that has Grab to automatically extend that condition to the end of the monster's next turn.</p></p></details></p>",
      "collapsed": false
    }
  ],
