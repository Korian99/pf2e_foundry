    {
      "name": "Swarm Mind",
      "actions": null,
      "traits": [],
      "description": "<p><details><summary>See rules...</summary>\n<p><p>This monster doesn't have a single mind (typically because it's a swarm of smaller creatures), and is immune to mental effects that target only a specific number of creatures. It is still subject to mental effects that affect all creatures in an area.</p></p></details></p>",
      "collapsed": false
    },
    {
      "name": "Cling",
      "actions": -1,
      "traits": [],
      "description": "<p><strong>Trigger</strong> A creature leaves the swarm's space</p>\n<hr />\n<p><strong>Effect</strong> The swarm takes 1d6 damage as ticks cling to the creature and continue biting, dealing 3d6 Bleed Damage. Immersion in water reduces the DC of the flat check to end this persistent damage to 5, and any area damage dealt to the creature destroys these clinging ticks.</p>",
      "collapsed": false
    }
  ],
