  "offensiveAbilities": [
    {
      "name": "Sprint",
      "actions": 2,
      "traits": [],
      "description": "<p><strong>Frequency</strong> once per minute</p>\n<hr />\n<p><strong>Effect</strong> The terror shrike Strides three times in a straight line.</p>",
      "collapsed": false
    },
    {
      "name": "Stunning Screech",
      "actions": 1,
      "traits": [
        "auditory",
        "emotion",
        "fear",
        "mental"
      ],
      "description": "<p>The terror shrike unleashes a haunting screech that causes prey to freeze in fear. Each creature in a 30ft Emanation other than terror birds must attempt a DC 19 Will Saving Throw save. Regardless of the result, creatures are then temporarily immune for 1 minute.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature is Off-Guard until the start of its turn.</p>\n<p><strong>Failure</strong> The creature is Stunned 1.</p>\n<p><strong>Critical Failure</strong> The creature is Stunned 2.</p>",
      "collapsed": false
    },
    {
      "name": "Sudden Charge",
      "actions": 2,
      "traits": [],
      "description": "<p>The terror shrike Strides twice. If it ends its movement within melee reach of one creature, it can make a melee Strike against that creature.</p>",
      "collapsed": false
    },
    {
      "name": "Tearing Clutch",
      "actions": null,
      "traits": [],
      "description": "<p>The terror bird's powerful beak can tear through flesh. On a successful beak Strike, the target takes 1 Bleed Damage damage. This bleed damage increases to 1d8 Bleed Damage on a critical hit.</p>",
      "collapsed": false
    },
    {
      "name": "Knockdown",
      "actions": 1,
      "traits": [],
      "description": "<p><details><summary>See rules...</summary>\n<p><p><strong>Requirements</strong> The monster's last action was a successful Strike that lists Knockdown in its damage entry</p><hr /><p><strong>Effect</strong> The monster attempts to Trip the creature. This attempt neither applies nor counts toward the monster's multiple attack penalty.</p></p></details></p>",
      "collapsed": false
    }
  ],
