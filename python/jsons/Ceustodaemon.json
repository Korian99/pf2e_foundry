            "revelation"
          ],
          "castingTime": "2",
          "duration": "10 minutes",
          "range": "",
          "area": "",
          "targets": "",
          "save": "",
          "description": "<p>You can see Invisible creatures and objects. They appear to you as translucent shapes, and they are Concealed to you.</p>\n<hr />\n<p><strong>Heightened (5th)</strong> The spell has a duration of 8 hours.</p>\n<p></p>",
