  "offensiveAbilities": [
    {
      "name": "Express Meal",
      "actions": 2,
      "traits": [],
      "description": "<p>Bristlebane makes a whip Strike against one creature within reach, on a success she pulls the target into an adjacent square. This is forced movement. She then Strikes the pulled target with her jaws. Both attacks count against her multiple attack penalty but don't apply until after both attacks.</p>",
      "collapsed": false
    },
    {
      "name": "Pack Attack",
      "actions": null,
      "traits": [],
      "description": "<p>A gnoll deals 1d4 extra damage to any creature that's within reach of at least two of the gnoll's allies.</p>",
      "collapsed": false
    },
    {
      "name": "Whip Whirlwind",
      "actions": 3,
      "traits": [],
      "description": "<p>Bristlebane uses her whip to Disarm, Strike, or Trip each creature within her reach. She can select a different action for each target. She takes a -2 circumstance penalty on the check for each action, and each action counts against her multiple attack penalty, but her multiple attack penalty doesn't increase until after all the actions.</p>",
      "collapsed": false
    }
