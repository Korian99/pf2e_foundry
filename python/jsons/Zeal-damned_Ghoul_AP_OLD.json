  "offensiveAbilities": [
    {
      "name": "Consume Flesh",
      "actions": 1,
      "traits": [
        "manipulate"
      ],
      "description": "<p><strong>Requirements</strong> The ghoul is adjacent to the corpse of an evil or chaotic creature that died within the last hour.</p>\n<hr />\n<p><strong>Effect</strong> The ghoul devours a chunk of the corpse and regains 6d6 Healing Damage Hit Points. It can regain Hit Points from any given corpse only once.</p>",
      "collapsed": false
    },
    {
      "name": "Ghoul Fever",
      "actions": null,
      "traits": [
        "disease"
      ],
      "description": "<p><strong>Saving Throw</strong> DC 27 Fortitude Saving Throw</p>\n<p><strong>Stage 1</strong> carrier with no ill effect (1 day)</p>\n<p><strong>Stage 2</strong> 2d6 Void Damage damage and regains half as many Hit Points from all healing (1 day)</p>\n<p><strong>Stage 3</strong> as stage 2 (1 day)</p>\n<p><strong>Stage 4</strong> 2d6 Void Damage damage and gains no benefit from healing (1 day)</p>\n<p><strong>Stage 5</strong> as stage 4 (1 day)</p>\n<p><strong>Stage 6</strong> dead, and rises as a zeal-damned ghoul the next midnight.</p>",
      "collapsed": false
    },
    {
      "name": "Paralysis",
      "actions": null,
      "traits": [
        "incapacitation",
        "occult"
      ],
      "description": "<p>Any living, non-elf creature hit by a ghoul's attack must succeed at a DC 27 Fortitude Saving Throw save or become Paralyzed. It can attempt a new save at the end of each of its turns, and the DC cumulatively decreases by 1 on each such save.</p>",
      "collapsed": false
    },
    {
      "name": "Swift Leap",
      "actions": 1,
      "traits": [
        "move"
      ],
      "description": "<p>The ghoul jumps up to half its Speed. This movement doesn't trigger reactions.</p>",
      "collapsed": false
    }
  ],
