    {
      "name": "Feed on Fear",
      "actions": 1,
      "traits": [
        "concentrate"
      ],
      "description": "<p><strong>Frequency</strong> once per round</p>\n<p><strong>Requirements</strong> An enemy within 15 feet is under a fear effect or dying</p>\n<hr />\n<p><strong>Effect</strong> The will-o'-wisp feeds on the creature's terror. It regains 2d4 Healing Damage{2d4 Hit Points}, and if it has Gone Dark, its glow reignites.</p>",
      "collapsed": false
    },
    {
      "name": "Go Dark",
      "actions": 1,
      "traits": [
        "concentrate"
      ],
      "description": "<p>The will-o'-wisp extinguishes its glow, becoming Invisible. It can end this effect with another use of this action. If it uses its shock attack while invisible, the arc of electricity lets any observer determine its location, making the will-o'-wisp only Hidden to all observers until it moves.</p>",
      "collapsed": false
    }
