  "offensiveAbilities": [
    {
      "name": "Breath Weapon",
      "actions": 2,
      "traits": [
        "fire",
        "primal"
      ],
      "description": "<p>The dragon breathes a blast of magma that deals 9d6 Fire Damage|options:area-damage]{9d6 fire damage and 4d12 bludgeoning damage} in a 40ft Cone (Basic DC 33 Reflex Saving Throw save).</p>\n<p>They can't use Breath Weapon again for 1d4 rounds.</p>",
      "collapsed": false
    },
    {
      "name": "Draconic Frenzy",
      "actions": 2,
      "traits": [],
      "description": "<p>The dragon makes two claw Strikes and one horn Strike in any order.</p>",
      "collapsed": false
    },
    {
      "name": "Draconic Momentum",
      "actions": null,
      "traits": [],
      "description": "<p>The dragon recharges their Breath Weapon whenever they score a critical hit with a Strike.</p>",
      "collapsed": false
    },
    {
      "name": "Volcanic Purge",
      "actions": 1,
      "traits": [],
      "description": "<p>If the next action the dragon uses is Breath Weapon, the magma clings to those it damages. Each creature that fails its save against the Breath Weapon takes 4d6 Persistent,fire Damage damage, and as long as it has this persistent fire damage, it also takes a -10-foot status penalty to its Speeds.</p>",
      "collapsed": false
    }
