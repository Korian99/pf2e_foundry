  "offensiveAbilities": [
    {
      "name": "Covetous Flames",
      "actions": null,
      "traits": [],
      "description": "<p>Any weapon the ascendant holds gains the effects of a Flaming rune while they hold it.</p>",
      "collapsed": false
    },
    {
      "name": "Furious Wings",
      "actions": 2,
      "traits": [],
      "description": "<p>The ascendant beats their wings in a frenzied motion, creating a powerful blast of wind that disperses fog and gases and blows objects of light Bulk or less away. All creatures within 20 feet of the ascendant must succeed at a DC 24 Reflex Saving Throw save or be pushed 5 feet away from the ascendant, or 10 feet on a critical failure. A flying creature that fails its save gets a critical failure instead.</p>",
      "collapsed": false
    }
  ],
