  "offensiveAbilities": [
    {
      "name": "Hunt Prey",
      "actions": 1,
      "traits": [
        "concentrate"
      ],
      "description": "<p>Ajbal designates a single creature he can see and hear, or one he's Tracking, as his prey. Ajbal gains a +2 circumstance bonus to Perception checks to Seek his prey and Survival checks to Track his prey.</p>\n<p>The first time Ajbal hits his designated prey in a round, he deals an additional 2d8 precision damage. Ajbal also ignores the penalty for making ranged attacks within the second range increment when attacking his prey.</p>\n<p>These effects last until Ajbal uses Hunt Prey again.</p>",
      "collapsed": false
    },
    {
      "name": "Sneak Attack",
      "actions": null,
      "traits": [],
      "description": "<p>Ajbal deals an additional 1d6 precision damage to Off-Guard creatures.</p>",
      "collapsed": false
    },
    {
      "name": "Tear the Wound",
      "actions": 1,
      "traits": [],
      "description": "<p><strong>Requirements</strong> Ajbal's last action was a melee Strike that dealt sneak attack damage to an Off-Guard target</p>\n<hr />\n<p><strong>Effect</strong> Ajbal deals 6 Bleed Damage damage to the target creature, and the target is Enfeebled 1 for as long as it's bleeding.</p>",
      "collapsed": false
    },
    {
      "name": "Trident Bully",
      "actions": null,
      "traits": [],
      "description": "<p>A trident Ajbal is using gains the shove trait, and any creature Ajbal critically hits with a trident is Off-Guard until the start of Ajbal's next turn.</p>",
      "collapsed": false
    }
