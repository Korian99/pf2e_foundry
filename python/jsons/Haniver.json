  "offensiveAbilities": [
    {
      "name": "Rearrange Possessions",
      "actions": 1,
      "traits": [
        "manipulate"
      ],
      "description": "<p>◆ or ◆◆</p>\n<p>The haniver attempts to Steal a small object off a target's person.</p>\n<p>If they succeed, they also rifle through and rearrange the contents of the target's pockets, pouches, and other containers. The next time the target attempts to draw a weapon or retrieve a worn item, doing so requires 2 Interact actions instead of one.</p>\n<p>The haniver can Steal an object that's closely guarded using this action without the –5 penalty, though not objects that would be extremely noticeable or time-consuming to remove. They can spend 2 actions instead of 1 to use this ability to Steal from a creature in combat or otherwise on guard.</p>",
      "collapsed": false
    }
  ],
  "spellcastingEntries": [
    {
      "name": "Primal Innate Spells",
      "type": "innate",
