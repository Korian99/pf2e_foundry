  "generalAbilities": [
    {
      "name": "Rooted",
      "actions": null,
      "traits": [],
      "description": "<p>A rootridden is bonded to a specific root network. If it's more than 300 feet from this network for at least 1 minute, it becomes Sickened 2 until it's again within 300 feet of the root network for at least 1 minute.</p>",
      "collapsed": false
    },
    {
      "name": "Walk the Roots",
      "actions": null,
      "traits": [],
      "description": "<p>The rootridden ignores the effects of difficult terrain caused by plants and fungi.</p>",
      "collapsed": false
    }
