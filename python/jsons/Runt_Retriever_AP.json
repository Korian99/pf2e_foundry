  "offensiveAbilities": [
    {
      "name": "Eye Ray",
      "actions": 2,
      "traits": [],
      "description": "<p>The retriever makes a ranged eye ray Strike against an enemy within 60 feet. On a hit, the retriever chooses one of the four options listed below. The retriever cannot use the same effect in consecutive rounds. Once the retriever has used all four options, the eye ray Strike can't be used for 1d4 rounds.</p><ul><li><strong>Cold</strong> The enemy takes (2d12+13) Cold Damage damage</li><li><strong>Electricity</strong> The enemy takes (2d12+13) Electricity Damage damage</li><li><strong>Fire</strong> The enemy takes (2d12+13) Fire Damage damage</li><li><strong>Petrification</strong> The enemy is targeted by a 6th-rank Petrify using the retriever's innate spell DC (DC 26 Fortitude Saving Throw).</li></ul>",
      "collapsed": false
    },
    {
      "name": "Grab",
      "actions": 1,
      "traits": [],
      "description": "<p><details><summary>See rules...</summary>\n<p><p><strong>Requirements</strong> The monster's last action was a successful Strike that lists Grab in its damage entry, or the monster has a creature Grabbed or Restrained</p><hr /><p><strong>Effect</strong> If used after a Strike, the monster attempts to Grapple the creature using the body part it attacked with. This attempt neither applies nor counts toward the creature's multiple attack penalty.</p><p>The monster can instead use Grab and choose one creature it's grabbing or restraining with an appendage that has Grab to automatically extend that condition to the end of the monster's next turn.</p></p></details></p>",
      "collapsed": false
    }
  ],
