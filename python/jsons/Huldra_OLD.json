  "offensiveAbilities": [
    {
      "name": "Befuddling Lash",
      "actions": null,
      "traits": [
        "curse",
        "mental"
      ],
      "description": "<p>When the huldra damages a creature with their tail, a wave of befuddlement clouds the target's thoughts. The creature must succeed at a DC 19 Will Saving Throw save or become Stupefied 1 (Stupefied 2 on a critical failure) for 1 minute.</p>",
      "collapsed": false
    },
    {
      "name": "Manipulate Luck",
      "actions": 1,
      "traits": [
        "curse",
        "primal"
      ],
      "description": "<p><strong>Frequency</strong> once per day</p>\n<hr />\n<p><strong>Effect</strong> The huldra touches another creature to manipulate the creature's luck. The creature must attempt a DC 21 Will Saving Throw save.</p>\n<p>On a failure, the huldra chooses good luck or bad luck. If the huldra chooses good luck, the affected creature can roll twice on one d20 roll within the next minute and use the higher result; this is a fortune effect. If the huldra chooses bad luck, the creature must roll twice and use the lower result on its next d20 roll; this is a misfortune effect.</p>\n<p>Effect: Manipulate Luck (Good)</p>\n<p>Effect: Manipulate Luck (Bad)</p>",
      "collapsed": false
    }
  ],
