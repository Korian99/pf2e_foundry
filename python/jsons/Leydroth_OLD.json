  "offensiveAbilities": [
    {
      "name": "Dispelling Roar",
      "actions": 2,
      "traits": [
        "auditory",
        "emotion",
        "fear",
        "mental",
        "primal"
      ],
      "description": "<p>The leydroth unleashes a bestial roar that reverberates within a 30ft Emanation. It rolls an Intimidation check and compares the result to the Will DC of each creature in the area, with the effects of Demoralize.</p>\n<p>It also uses this result to attempt to counteract each spell or magical effect in the area, plus one item or effect on each creature in the area, with the effects of Dispel Magic.</p>\n<p>The leydroth can't use Dispelling Roar again for 1d4 rounds.</p>",
      "collapsed": false
    },
    {
      "name": "Dispelling Strike",
      "actions": 0,
      "traits": [
        "primal"
      ],
      "description": "<p><strong>Frequency</strong> once per round</p>\n<p><strong>Trigger</strong> The leydroth hits a creature, object, or spell effect with a Strike</p>\n<hr />\n<p><strong>Effect</strong> The leydroth casts its innate Dispel Magic, targeting one effect on the creature struck.</p>",
      "collapsed": false
    },
    {
      "name": "Spell Feedback",
      "actions": null,
      "traits": [
        "primal"
      ],
      "description": "<p>Any time a leydroth counteracts a spell or item, the spell's caster or the creature holding the item takes 8d6 Mental Damage damage (Basic DC 38 Will Saving Throw save).</p>",
      "collapsed": false
    }
  ],
