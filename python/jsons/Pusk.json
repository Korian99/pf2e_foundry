  "offensiveAbilities": [
    {
      "name": "Cower",
      "actions": 1,
      "traits": [],
      "description": "<p>The pusk makes itself as small as possible, protecting its vital organs with its limbs. It gains a +4 circumstance bonus to AC but takes a –2 penalty to attack rolls. This lasts until the pusk moves from its current space, falls Unconscious, or ends the effect as a free action.</p>",
      "collapsed": false
    },
    {
      "name": "Frenzied Slashes",
      "actions": 3,
      "traits": [],
      "description": "<p>The pusk makes three claw Strikes, each at a –2 penalty, all targeting the same creature. The pusk's multiple attack penalty doesn't increase until after it has made all three attacks. The pusk gains the Clumsy 2 condition until the beginning of its next turn.</p>",
      "collapsed": false
    },
    {
      "name": "Vicious Criticals",
      "actions": null,
      "traits": [],
      "description": "<p>A pusk makes the most of any weakness it finds. Whenever a pusk scores a critical hit with its claw Strike, the target takes an additional 1d6 Bleed Damage{1d6 persistent bleed} damage.</p>",
      "collapsed": false
    }
  ],
