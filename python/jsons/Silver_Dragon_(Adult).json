  "offensiveAbilities": [
    {
      "name": "Breath Weapon",
      "actions": 2,
      "traits": [],
      "description": "<p>The silver dragon breathes in one of two ways.</p>\n<p>The dragon can't use Breath Weapon again for 1d4 rounds.</p><ul><li><strong>Frost</strong> (arcane, cold) The dragon breathes a cloud of frost in a 40ft Cone that deals 15d6 Cold Damage damage (Basic DC 35 Reflex Saving Throw save).</li><li><strong>Paralyzing Gas</strong> (arcane, incapacitation) The dragon breathes a blast of paralyzing gas. Each creature within a 40ft Cone must succeed at a Basic DC 35 Fortitude Saving Throw save or be Slowed 2 for 1 round (or Paralyzed for 2 rounds on a critical failure).</li></ul>",
      "collapsed": false
    },
    {
      "name": "Draconic Frenzy",
      "actions": 2,
      "traits": [],
      "description": "<p>The silver dragon makes two claw Strikes and one tail Strike in any order.</p>",
      "collapsed": false
    },
    {
      "name": "Draconic Momentum",
      "actions": null,
      "traits": [],
      "description": "<p>When the silver dragon scores a critical hit with a Strike, it recharges its Breath Weapon.</p>",
      "collapsed": false
    }
