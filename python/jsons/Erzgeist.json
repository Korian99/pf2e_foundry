  "offensiveAbilities": [
    {
      "name": "Aurify",
      "actions": null,
      "traits": [
        "incapacitation",
        "morph",
        "primal"
      ],
      "description": "<p>The touch of an erzgeist transforms flesh into gold. When a living creature is damaged by the erzgeist's gilded hand Strike, that creature must attempt a DC 41 Fortitude Saving Throw save or become Clumsy 1 (or Clumsy 2 on a critical failure) for 1 minute. Further failed saves against aurify increase the clumsy condition. Once a creature becomes Clumsy 5, they become petrified, except they're transformed into gold instead of stone for 24 hours, after which the creature (or any gold harvested from it) crumbles to worthless dust and dies.</p>",
      "collapsed": false
    }
  ],
