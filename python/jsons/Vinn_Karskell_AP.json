  "offensiveAbilities": [
    {
      "name": "Drink Qi",
      "actions": -1,
      "traits": [],
      "description": "<p><strong>Trigger</strong> Vinn critically hits a foe with an unarmed Strike</p><hr /><p><strong>Effect</strong> Vinn cries out in triumph and absorbs a bit of the target's spiritual energy. He regains 10 Healing Damage Hit Points.</p>",
      "collapsed": false
    },
    {
      "name": "Flurry of Blows",
      "actions": 1,
      "traits": [],
      "description": "<p><strong>Frequency</strong> once per round</p><hr /><p><strong>Effect</strong> Vinn makes two unarmed Strikes. If both hit the same creature, combine their damage for the purpose of resistances and weaknesses. Apply Vinn's multiple attack penalty to the Strikes normally. When Vinn targets the same creature with both Strikes, if either Strike hits, the target must succeed at a DC 24 Fortitude Saving Throw save or be Stunned 1 (Stunned 3 on a critical failure). This is an incapacitation effect.</p>\n<p>Alternatively, Vinn can replace one or both of his attacks during Flurry of Blows with Grapples, Repositions, Shoves, or Trips.</p>",
      "collapsed": false
    },
    {
      "name": "Powerful Fist",
      "actions": null,
      "traits": [],
      "description": "<p>Vinn doesn't take the normal –2 circumstance penalty when making a lethal attack with his unarmed attacks.</p>",
      "collapsed": false
    },
    {
      "name": "Wolf Stance",
      "actions": 1,
      "traits": [
        "stance"
      ],
      "description": "<p>Vinn enters the stance of the wolf, crouching low to the ground and with his fingers curled like fangs, allowing him to make wolf jaw Strikes with his hands. If he's flanking while in this stance, his wolf jaw strikes gain the trip trait. Once Vinn enters wolf stance, he remains in the stance until he is knocked out or is no longer in combat.</p>",
      "collapsed": false
    }
  ],
