  "offensiveAbilities": [
    {
      "name": "Phlegm Skitter",
      "actions": 2,
      "traits": [
        "primal",
        "water"
      ],
      "description": "<p>The tormonshild swarm Strides, leaving pools of mucus as it moves. Each space the swarm moves through during this movement becomes coated with slippery mucus, which has the area effect of Grease (DC 17 Reflex Saving Throw).</p>",
      "collapsed": false
    },
    {
      "name": "Phlegm Spray",
      "actions": 2,
      "traits": [
        "primal",
        "water"
      ],
      "description": "<p>The tormonshild swarm sprays globules of mucus and water in every direction, dealing 3d6 Bludgeoning Damage damage (Basic DC 20 Reflex Saving Throw save) to all creatures within 10 feet. Creatures that fail the save are covered in mucus and become Dazzled for 1 minute. A creature covered in mucus can end the condition by using an Interact action to remove the mucus.</p>",
      "collapsed": false
    },
    {
      "name": "Swarming Leap",
      "actions": 2,
      "traits": [],
      "description": "<p>The tormonshild swarm jumps as a collective. It Leaps 50 feet horizontally.</p>",
      "collapsed": false
    },
    {
      "name": "Torrent of Bites",
      "actions": 1,
      "traits": [],
      "description": "<p>Each enemy in the tormonshild swarm's space takes 2d6 Piercing Damage damage (Basic DC 20 Reflex Saving Throw save).</p>",
      "collapsed": false
    }
  ],
