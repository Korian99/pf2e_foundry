  "offensiveAbilities": [
    {
      "name": "Rappel",
      "actions": 1,
      "traits": [
        "move"
      ],
      "description": "<p>The timberweb moves straight down up to 60 feet on a spun vine. It can hang from the vine or drop off. The distance it descends doesn't count toward falling damage. A creature that successfully Strikes the vine (AC 36, Hardness 8, 30 HP) severs it, causing the timberweb to fall.</p>",
      "collapsed": false
    },
    {
      "name": "Timberweb Toxin",
      "actions": null,
      "traits": [
        "poison"
      ],
      "description": "<p><strong>Saving Throw</strong> DC 34 Fortitude Saving Throw</p>\n<p><strong>Maximum Duration</strong> 6 rounds</p>\n<p><strong>Stage 1</strong> 5d6 Poison Damage damage and Clumsy 1 (1 round)</p>\n<p><strong>Stage 2</strong> 6d6 Poison Damage damage and Clumsy 2 (1 round)</p>\n<p><strong>Stage 3</strong> 8d6 Poison Damage damage and clumsy 2 (1 round)</p>",
      "collapsed": false
    },
    {
      "name": "Tree Tether",
      "actions": null,
      "traits": [],
      "description": "<p>A creature hit by the timberweb's vine Strike becomes entangled by the sticky fibers, taking a –15-foot penalty to its Speeds for 1 minute or until it Escapes (DC 34) or is cut free (AC 36, Hardness 8, 30 HP). If the target is adjacent to a wooden object of its size or larger, the target is instead Immobilized and stuck to that object until it Escapes or is cut free.</p>",
      "collapsed": false
    }
  ],
