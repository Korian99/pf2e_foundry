    {
      "name": "Earth Glide",
      "actions": null,
      "traits": [],
      "description": "<p>An earthen destrier can Burrow through earthen matter, including rock. When it does so, it moves at its full burrow Speed, leaving no tunnels or signs of its passing.</p>",
