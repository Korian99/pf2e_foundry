      "name": "Shrieking Frenzy",
      "actions": 0,
      "traits": [
        "primal"
      ],
      "description": "<p><strong>Trigger</strong> The charau-ka's turn begins.</p>\n<p><strong>Frequency</strong> once per hour</p>\n<hr />\n<p><strong>Effect</strong> The charau-ka is Quickened until the end of its turn, and can use the extra action to Stride or Strike.</p>\n<p>While in the frenzy, the charau-ka can't speak and automatically critically fails Stealth checks, due to its loud wailing.</p>",
      "collapsed": false
    },
    {
      "name": "Thrown Weapon Mastery",
      "actions": null,
      "traits": [
        "nonlethal"
      ],
      "description": "<p>Any weapon a charau-ka throws gains the deadly d6 weapon trait.</p>\n<p>Furthermore, when a charau-ka throws an improvised weapon, it does not take the -2 penalty for doing so, nor does it take a penalty for using a thrown improvised weapon with the nonlethal trait to make a lethal attack.</p>",
      "collapsed": false
    }
