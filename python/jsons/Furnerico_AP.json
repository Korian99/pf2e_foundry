  "generalAbilities": [
    {
      "name": "Fetid Aura",
      "actions": null,
      "traits": [
        "aura",
        "olfactory"
      ],
      "description": "<p>80 feet. A creature entering or beginning its turn in a furnerico's fetid aura must succeed at a DC 31 Fortitude Saving Throw or be Sickened 1; the creature also becomes Enfeebled 1 until the end of their next turn. A creature that succeeds at its save is temporarily immune to all furnerico fetid auras for 1 minute.</p>",
      "collapsed": false
    },
    {
      "name": "Hydrophobic",
      "actions": null,
      "traits": [],
      "description": "<p>A furnerico avoids water and won't willingly approach within five feet of a body of water. It won't initiate an attack against any creature that's soaking wet with water or that has the water trait. A furnerico takes a –2 circumstance penalty to its attack rolls against such creatures who attack it.</p>",
      "collapsed": false
    },
    {
      "name": "Susceptible to Water",
      "actions": null,
      "traits": [],
      "description": "<p>A furnerico cleansed of filth becomes sluggish. If ever immersed fully in pure, clean water, or if it ever fails a saving throw against a water effect, the furnerico becomes Slowed 1 until it starts its turn in an area of filth or contaminated water.</p>",
      "collapsed": false
    }
  ],
