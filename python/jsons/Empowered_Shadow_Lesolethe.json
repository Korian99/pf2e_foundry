    {
      "name": "Blades of Shade",
      "actions": 2,
      "traits": [
        "divine"
      ],
      "description": "<p>Shadow Lesolethe causes the shadows cast by those around her to transform into a mesh of blades which erupt upwards at her foes in a 30ft Type:emanation. Enemy creatures in this area take 5d6 Slashing Damage damage (Basic DC 26 Reflex Saving Throw save).</p>",
      "collapsed": false
    },
    {
      "name": "Boiling Darkness",
      "actions": 2,
      "traits": [
        "auditory",
        "divine",
        "emotion",
        "fear",
        "mental"
      ],
      "description": "<p>Shadow-Lesolethe utters a scream which causes shadows to churn and boil. Each living enemy within 30 feet to attempt a DC 26 Will Saving Throw save. On a failure, a creature becomes Frightened 2 (Frightened 3 on a critical failure). On a success, a creature is temporarily immune to Boiling Darkness for 1 minute.</p>",
      "collapsed": false
    }
