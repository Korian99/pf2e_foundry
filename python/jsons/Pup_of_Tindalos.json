  "defensiveAbilities": [
    {
      "name": "Otherworldly Mind",
      "actions": null,
      "traits": [
        "mental"
      ],
      "description": "<p>Whenever a creature targets the pup with a mental effect, that creature takes 2d6 Mental Damage damage (Basic DC 20 Will Saving Throw save). On a critical failure, it also becomes Confused for 1 round.</p>",
      "collapsed": false
    },
    {
      "name": "Ripping Gaze",
      "actions": null,
      "traits": [
        "aura",
        "occult",
        "visual"
      ],
      "description": "<p>15 feet. The pup of Tindalos's eyes glow balefully, causing painful but bloodless wounds to rip open in the body of a creature that meets its awful gaze. When a creature ends its turn in the aura's emanation, it takes 1d8 Slashing Damage damage (Basic DC 20 Fortitude Saving Throw save). A creature that critically succeeds at its save is temporarily immune for 24 hours.</p>",
      "collapsed": false
    },
    {
      "name": "Vulnerable to Curved Space",
      "actions": null,
      "traits": [],
      "description": "<p>When a pup of Tindalos is not adjacent to a structural angle of 90° (or more acute), its resistance to physical damage is suppressed and it becomes Sickened 1. It can't recover from this sickened condition, but the condition ends automatically once the pup is again adjacent to a suitable angle.</p>\n<p>Effect: Vulnerable to Curved Space</p>",
      "collapsed": false
    }
  ],
