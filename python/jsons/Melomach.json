  "offensiveAbilities": [
    {
      "name": "Lightning Punch",
      "actions": 2,
      "traits": [],
      "description": "<p>The melomach makes a fist Strike, then makes a lightning Strike against a different creature within 120 feet of the fist Strike's target. Both Strikes count toward the melomach's multiple attack penalty, but it doesn't increase until after both attacks are made.</p>",
      "collapsed": false
    },
    {
      "name": "Rhythmic Stomp",
      "actions": 1,
      "traits": [
        "emotion",
        "mental",
        "primal"
      ],
      "description": "<p><strong>Frequency</strong> once per round</p>\n<hr />\n<p><strong>Effect</strong> The melomach's footsteps raise a clanging sound through their body to create a brief musical phrase. The melomach Strides, then generates the effect of one of the following bard composition cantrips at 7th rank: Allegro, Dirge of Doom (adds the fear trait), or Triple Time.</p>",
      "collapsed": false
    },
    {
      "name": "Scream",
      "actions": 2,
      "traits": [
        "primal",
        "sonic"
      ],
      "description": "<p>The melomach unleashes a guttural, ear-piercing wail. All creatures in a 120ft Cone take 7d12 Sonic Damage damage with a DC 32 Fortitude Saving Throw save.</p>\n<p>The melomach can't Scream again for 1d4 rounds.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature takes half damage.</p>\n<p><strong>Failure</strong> The creature takes full damage, is Stunned 1, and is Deafened for 1 minute.</p>\n<p><strong>Critical Failure</strong> The creature takes double damage, is Stunned 3, and is deafened permanently.</p>",
      "collapsed": false
    }
  ],
