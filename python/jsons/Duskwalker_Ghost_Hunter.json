  "offensiveAbilities": [
    {
      "name": "Ghost Hunter",
      "actions": null,
      "traits": [],
      "description": "<p>The duskwalker's weapons have the benefits of the <em>Ghost Touch</em> property rune on attacks against incorporeal undead.</p>",
      "collapsed": false
    },
    {
      "name": "Spirit Hunter",
      "actions": 1,
      "traits": [],
      "description": "<p>The duskwalker designates a single creature they can observe as their prey.</p>\n<p>The duskwalker gains a +2 circumstance bonus to Deception checks, Intimidation checks, and Stealth checks against their prey and to any check to Recall Knowledge about it, and deal an additional 2 Spirit Damage damage with all weapon Strikes against their prey.</p>\n<p>These effects last until the duskwalker uses Spirit Hunter again.</p>",
      "collapsed": false
    },
    {
      "name": "Spirit Shot",
      "actions": 1,
      "traits": [],
      "description": "<p><strong>Frequency</strong> once per round</p>\n<p><strong>Requirements</strong> The duskwalker has designated a creature as their prey using Spirit Hunter</p>\n<hr />\n<p><strong>Effect</strong> The duskwalker makes two ranged Strikes against their prey. If both Strikes hit, combine their damage for the purpose of resistances and weaknesses.</p>",
      "collapsed": false
    }
