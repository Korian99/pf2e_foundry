  "offensiveAbilities": [
    {
      "name": "Breath Weapon",
      "actions": 2,
      "traits": [],
      "description": "<p>The brass dragon breathes in one of two ways.</p>\n<p>The dragon can't use Breath Weapon again for 1d4 rounds.</p><ul><li><strong>Flame</strong> (arcane, fire) The dragon breathes fire in a 100ft Line that deals 16d6 Fire Damage damage (Basic DC 39 Reflex Saving Throw save).</li><li><strong>Sleep Gas</strong> (arcane, incapacitation, sleep) The dragon breathes a 80ft Cone of sleep gas. Each creature in the area must succeed at a Basic DC 39 Fortitude Saving Throw save or fall Unconscious for 1d6 rounds, or 1 minute on a critical failure.</li></ul>",
      "collapsed": false
    },
    {
      "name": "Desert Wind",
      "actions": 2,
      "traits": [
        "air",
        "arcane",
        "concentrate"
      ],
      "description": "<p><strong>Frequency</strong> three times per day</p>\n<hr />\n<p><strong>Effect</strong> The dragon calls upon the desert wind. This has the same effect as Gust of Wind (DC 37 Fortitude Saving Throw) but in a 60ft Cone.</p>\n<p>A creature that fails its save is also Blinded until the end of its next turn (or for 1 minute on a critical failure).</p>",
      "collapsed": false
    },
    {
      "name": "Draconic Frenzy",
      "actions": 2,
      "traits": [],
      "description": "<p>The dragon makes two claw Strikes and one jaws Strike in any order.</p>",
      "collapsed": false
    },
    {
      "name": "Draconic Momentum",
      "actions": null,
      "traits": [],
      "description": "<p>When the dragon scores a critical hit with a strike, it recharges Breath Weapon.</p>",
      "collapsed": false
    }
