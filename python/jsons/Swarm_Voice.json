  "offensiveAbilities": [
    {
      "name": "Advise Swarm",
      "actions": 2,
      "traits": [
        "auditory",
        "linguistic",
        "mental"
      ],
      "description": "<p>The swarm voice issues orders to move. Each ratfolk from the same warren in a 15ft Type:emanation can spend a reaction to Step, Stride, or Take Cover.</p>",
      "collapsed": false
    },
    {
      "name": "Chittering Terror",
      "actions": 2,
      "traits": [
        "auditory",
        "emotion",
        "fear",
        "mental"
      ],
      "description": "<p>The swarm voice chitters, creating a terrifying din, and encourages their allies to join in. Each enemy within 30 feet must succeed at a DC 19 Will Saving Throw save or be Frightened 1 (or Frightened 2 on a critical failure). An enemy takes a –2 circumstance penalty to its save if it's adjacent to one or more ratfolk allied with the swarm voice. Regardless of the result of a creature's save, it's then temporarily immune for 1 hour.</p>",
      "collapsed": false
    },
    {
      "name": "Swarming",
      "actions": null,
      "traits": [],
      "description": "<p>A swarm voice can end their movement in the same square as an ally that also has this ability. Only two such creatures can share the same space.</p>",
      "collapsed": false
    }
