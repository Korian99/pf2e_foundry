  "offensiveAbilities": [
    {
      "name": "Aquatic Ambush",
      "actions": 1,
      "traits": [],
      "description": "<p>30 feet</p>\n<hr />\n<p><details><summary>See rules...</summary>\n<p><p><strong>Requirements</strong> The monster is hiding in water and a creature that hasn't detected it is within the listed number of feet.</p>\n<hr />\n<p><strong>Effect</strong> The monster moves up to its swim Speed + 10 feet toward the triggering creature, traveling on water and on land. Once the creature is in reach, the monster makes a Strike against it. The creature is Off-Guard against this Strike.</p></p></details></p>",
      "collapsed": false
    },
    {
      "name": "Dead Gaze",
      "actions": 2,
      "traits": [
        "mental",
        "visual"
      ],
      "description": "<p>Look into its beady little eyes. You are now Stunned for 1 round unless you succeeded on a DC 20 Will Saving Throw save.</p>",
      "collapsed": false
    },
    {
      "name": "Squeak of Doom",
      "actions": 3,
      "traits": [
        "auditory",
        "emotion",
        "mental"
      ],
      "description": "<p>The nosferotter lets out an ominous, but cute, squeak. All creatures within 30 feet must attempt a DC 20 Will Saving Throw save.</p>\n<p>They are then temporarily immune for 1 day.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature can do nothing but wonder whether the nosferotter is cute or terrifying for 1 round.</p>\n<p><strong>Failure</strong> The creature is so confused that it attacks its allies for 1 round.</p>\n<p><strong>Critical Failure</strong> As failure, but permanently. It's that bad.</p>",
      "collapsed": false
    }
  ],
