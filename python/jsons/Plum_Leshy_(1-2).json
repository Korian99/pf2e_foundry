  "offensiveAbilities": [
    {
      "name": "Bitter Harvest",
      "actions": null,
      "traits": [],
      "description": "<p>When a plum leshy hits with their rotten fruit Strike, the target must attempt a DC 15 Fortitude Saving Throw save.</p>\n<hr />\n<p><strong>Critical Success</strong> The target is unaffected and becomes temporarily immune to all plum leshys' bitter harvest for 1 hour.</p>\n<p><strong>Success</strong> The target is unaffected.</p>\n<p><strong>Failure</strong> The target is Sickened 1. Once it succeeds at its save to recover from the sickened condition, it is immune to all plum leshys' bitter harvest for 1 hour.</p>\n<p><strong>Critical Failure</strong> As failure, plus the target also takes a -1 penalty on all saves to recover from the sickened condition for 1 hour.</p>",
      "collapsed": false
    }
