    },
    {
      "name": "Drag",
      "actions": 1,
      "traits": [],
      "description": "<p>The hyaenodon makes a jaws Strike against a Prone enemy. If it hits, in addition to dealing damage, the hyaenodon Strides up to 10 feet, dragging the enemy along.</p>",
      "collapsed": false
    },
    {
      "name": "Pack Attack",
      "actions": null,
      "traits": [],
      "description": "<p>The hyaenodon deals an extra 1d6 damage to any creature within reach of at least two of the hyaenodon's allies.</p>",
      "collapsed": false
