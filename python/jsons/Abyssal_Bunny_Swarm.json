    {
      "name": "Swarming Bites",
      "actions": 1,
      "traits": [],
      "description": "<p>Each enemy in the swarm's space takes 1d6 Piercing Damage damage (Basic DC 14 Reflex Saving Throw save). A creature that critically fails its save is becomes Clumsy 1.</p>",
