  "offensiveAbilities": [
    {
      "name": "Breath Weapon",
      "actions": 1,
      "traits": [
        "arcane"
      ],
      "description": "<p>The i'iko dragon breathes a spray of jagged glass shards that deals 7d6 Piercing Damage damage in a 15ft Cone (Basic DC 24 Reflex Saving Throw save). They can't use Breath Weapon again for 1d4 rounds.</p>",
      "collapsed": false
    },
    {
      "name": "Cunning Capsize",
      "actions": 1,
      "traits": [
        "attack"
      ],
      "description": "<p>The i'iko dragon attempts to capsize an aquatic vessel of Medium size or smaller that they're on or adjacent to. They must succeed at an DC 25 Athletics  check with a DC of 25 or the pilot's Sailing Lore DC, whichever is higher.</p>",
      "collapsed": false
    },
    {
      "name": "Draconic Grandeur",
      "actions": 1,
      "traits": [
        "emotion",
        "fear",
        "mental"
      ],
      "description": "<p>The i'iko dragon spreads their wings, bares their teeth, and threatens their opponent in a terrifying display of draconic majesty. All creatures within 30 feet must attempt a DC 24 Will Saving Throw save. Regardless of the result of the saving throw, the creatures are temporarily immune to Draconic Grandeur for 1 minute.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature is Frightened 1.</p>\n<p><strong>Failure</strong> The creature is Frightened 2.</p>\n<p><strong>Critical Failure</strong> The creature is Frightened 4.</p>",
      "collapsed": false
    },
    {
      "name": "Tackle",
      "actions": 2,
      "traits": [
        "move"
      ],
      "description": "<p>The i'iko dragon Flies up to their fly Speed, descending at least 10 feet, and then makes a jaws Strike. If the jaws Strike hits and the target is Medium or smaller, the target is knocked Prone.</p>",
      "collapsed": false
    }
  ],
