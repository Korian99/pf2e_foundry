      "actions": 1,
      "traits": [],
      "description": "<p>(2d10+14) Bludgeoning Damage, Basic DC 36 Fortitude Saving Throw</p><hr /><p><details><summary>See rules...</summary>\n<p><p>The monster deals the listed amount of damage to any number of creatures Grabbed or Restrained by it. Each of those creatures can attempt a basic Fortitude save with the listed DC.</p></p></details></p>",
      "collapsed": false
    },
