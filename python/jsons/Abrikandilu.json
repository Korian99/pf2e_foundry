    {
      "name": "Hatred of Mirrors",
      "actions": null,
      "traits": [],
      "description": "<p>An abrikandilu loathes the sight of their reflection. When a creature Interacts with a mirror within sight of the wrecker demon, the demon takes a -2 penalty to Will saves against Intimidation checks.</p>\n<p>An abrikandilu that ends their turn adjacent to a mirror or that's attacked by a creature holding a mirror takes 1d6 Mental Damage damage (this usually leads abrikandilus to focus their efforts on destroying nearby mirrors using Wreck).</p>",
      "collapsed": false
    }
