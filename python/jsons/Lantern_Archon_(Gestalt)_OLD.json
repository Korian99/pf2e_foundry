  "offensiveAbilities": [
    {
      "name": "Flame of Justice",
      "actions": null,
      "traits": [
        "divine"
      ],
      "description": "<p>A gestalt's spirit of righteousness manifests in its hands as a mighty two-handed sword called the flame of justice.</p>\n<p>A gestalt can throw its flame of justice as a ranged weapon. If disarmed or thrown, the flame of justice vanishes after landing or dealing damage and reappears in the gestalt's hands again instantly.</p>\n<p>On a critical hit, the fire damage from the flame of justice deals maximum damage (6 Fire Damage{6} on the d6) before being doubled for the critical hit, and the target takes 1d10 Persistent,fire Damage damage.</p>",
      "collapsed": false
    },
    {
      "name": "Lantern of Hope",
      "actions": 1,
      "traits": [
        "concentrate",
        "divine",
        "mental"
      ],
      "description": "<p>The lantern archon shines as a beacon of hope.</p>\n<p>Good allies within 30 feet gain a +3 status bonus to damage rolls and to saving throws against Wave of Despair.</p>\n<p>Effect: Lantern of Hope (Gestalt)</p>",
      "collapsed": false
    }
  ],
