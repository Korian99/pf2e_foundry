  "offensiveAbilities": [
    {
      "name": "Daring Gambit",
      "actions": 2,
      "traits": [],
      "description": "<p>Ruby attempts to distract an enemy with a death-defying maneuver. She attempts an acrobatics|defense:reflex check against the Reflex DC of one target within her melee reach. On a success, Ruby Strides up to 15 feet (or 30 feet on a critical success) without triggering reactions from her target due to her movement, and the target is Off-Guard against Ruby's next melee Strike before the end of her turn. Regardless of the result of her Acrobatics check, Ruby attempts a melee Strike against the target.</p>",
      "collapsed": false
    },
    {
      "name": "Light Step",
      "actions": null,
      "traits": [],
      "description": "<p>Ruby ignores difficult terrain when she Strides or Steps.</p>",
      "collapsed": false
    },
    {
      "name": "Mobile Combatant",
      "actions": null,
      "traits": [],
      "description": "<p>Ruby's Strikes deal an additional 4d6 damage if she has moved at least 10 feet during her turn.</p>",
      "collapsed": false
