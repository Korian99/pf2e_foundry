      "name": "Lacridaemon Venom",
      "actions": null,
      "traits": [
        "poison",
        "unholy"
      ],
      "description": "<p><strong>Saving Throw</strong> DC 20 Fortitude Saving Throw</p>\n<p><strong>Maximum Duration</strong> 6 rounds</p>\n<p><strong>Stage 1</strong> 1d4 Poison Damage damage (1 round)</p>\n<p><strong>Stage 2</strong> 1d6 Poison Damage damage and Stupefied 1 (1 round)</p>\n<p><strong>Stage 3</strong> 1d8 Poison Damage damage, Confused, and stupefied 1 (1 round)</p>",
      "collapsed": false
    },
    {
      "name": "Venomous Spray",
      "actions": 2,
      "traits": [],
      "description": "<p>The lacridaemon's begins to weep, spraying its venom-filled tears at all creatures within 30 feet. The creatures are immediately exposed to lacridaemon venom. Other lacridaemons are immune to this venom.</p>",
      "collapsed": false
    }
