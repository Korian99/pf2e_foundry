  "offensiveAbilities": [
    {
      "name": "Blood Tide",
      "actions": 1,
      "traits": [
        "primal",
        "water"
      ],
      "description": "<p>The tide giant Swims, or Swims twice if their cloak of high tide is active. Holding out their trident, they slash those they pass, dealing 2d8 Piercing Damage damage and 2d6 Persistent,bleed Damage damage (Basic DC 24 Reflex Saving Throw save) to each enemy the giant moves within 10 feet of during their movement. Each creature can be affected only once during a single use of Blood Tide.</p>",
      "collapsed": false
    },
    {
      "name": "Tine and Tide",
      "actions": 2,
      "traits": [
        "primal",
        "water"
      ],
      "description": "<p>A wave blasts from the giant's trident in a 15ft Type:cone or a 5ft Type:burst within 100 feet. If the giant's cloak of high tide is active, this is a 30ft Type:cone or a 10ft Type:burst. Each creature in the area takes 9d8 Bludgeoning Damage damage with a Basic DC 33 Reflex Saving Throw save.</p>",
      "collapsed": false
    }
  ],
