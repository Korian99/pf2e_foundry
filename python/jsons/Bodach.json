    {
      "name": "Implacable Curse",
      "actions": 2,
      "traits": [],
      "description": "<p>The bodach makes a staf Strike. If it hits, it deals an additional 2d8 Spirit Damage damage, and the target must attempt a save against either Mumbletongue or Stumblefoot (the bodach's choice).</p>",
      "collapsed": false
    },
    {
      "name": "Mumbletongue",
      "actions": 2,
      "traits": [
        "auditory",
        "concentrate",
        "primal"
      ],
      "description": "<p>The bodach mumbles a string of half-comprehensible nonsense, cursing creatures within a 10ft Type:emanation. Each creature in the area must succeed at a DC 24 Will Saving Throw save or become Stupefied 1 for 1 minute (stupefed 2 on a critical failure).</p>",
      "collapsed": false
    },
    {
      "name": "Stumblefoot",
      "actions": 2,
      "traits": [
        "concentrate",
        "primal",
        "visual"
      ],
      "description": "<p>The bodach stares unblinkingly at its foes, cursing creatures within a 15ft Type:cone. Each creature in the area must succeed at a DC 24 Fortitude Saving Throw save or become Clumsy 1 and Enfeebled 1 for 1 minute (Clumsy 2 and Enfeebled 2 on a critical failure).</p>",
      "collapsed": false
    },
    {
      "name": "Unstoppable",
      "actions": null,
      "traits": [],
      "description": "<p>A bodach reduces any penalty it takes to its Speed by 5 feet (to a minimum of 0 feet). A bodach can ft into tight spaces as if it were a Small creature. It can move at its full Speed while Squeezing.</p>",
      "collapsed": false
    }
