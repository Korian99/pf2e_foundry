  "offensiveAbilities": [
    {
      "name": "Bubble Venom",
      "actions": null,
      "traits": [],
      "description": "<p>A creature bit by a desa-desa breaks out in large, painful blisters which expand and pop as water in the victim's body turns into volatile gasses. Magical healing of any kind counteracts the bubble venom</p>\n<p><strong>Saving Throw</strong> DC 18 Fortitude Saving Throw</p>\n<p><strong>Maximum Duration</strong> 6 rounds</p>\n<p><strong>Stage 1</strong> weakness to fire 2 and 1d6 Piercing Damage (1 round)</p>\n<p><strong>Stage 2</strong> weakness to fire 4 and 2d6 Piercing Damage (1 round)</p>",
      "collapsed": false
    },
    {
      "name": "Fire Blast",
      "actions": 2,
      "traits": [
        "arcane",
        "fire"
      ],
      "description": "<p>The desa-desa releases a burst of explosive gasses in all directions, dealing 3d6 Fire Damage to all creatures in a 5ft Emanation. The desa-desa can't use Fire Blast again for 1d4 rounds.</p>",
      "collapsed": false
    },
    {
      "name": "Volatile Gasses",
      "actions": null,
      "traits": [],
      "description": "<p>Whenever a desa-desa takes electricity damage, it must attempt a DC 18 Fortitude Saving Throw save. On a failure, the sparks cause the desa-desa to immediately use Fire Blast if it can, and the desa-desa becomes off-guard for 1 round.</p>",
      "collapsed": false
    }
