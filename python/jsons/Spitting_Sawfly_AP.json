    {
      "name": "Consume Essence",
      "actions": 1,
      "traits": [
        "healing",
        "manipulate",
        "primal"
      ],
      "description": "<p><strong>Frequency</strong> once per day;</p>\n<p><strong>Requirements</strong> The spitting sawfly is adjacent to a creature with the wood trait or to a coiled conifer</p><hr /><p><strong>Effect</strong> The sawfly feasts upon the targeted creature or the coiled conifer's sap, regaining 5d6 Healing Damage{5d6 Hit Points}. A targeted creature must attempt a DC 29 Fortitude Saving Throw save or become Drained 1 (Drained 2 on a critical failure).</p>",
      "collapsed": false
    },
    {
      "name": "Creeping Sprout",
      "actions": null,
      "traits": [
        "disease"
      ],
      "description": "<p>A creature afflicted with creeping sprout is treated by the spitting sawfly as if it has the wood trait</p>\n<p><strong>Saving Throw</strong> DC 29 Fortitude Saving Throw;</p>\n<p><strong>Stage 1</strong> carrier with no ill effect (1d4 days)</p>\n<p><strong>Stage 2</strong> Drained 1 (1d4 days);</p>\n<p><strong>Stage 3</strong> 12d6 Acid Damage damage, creeping cone swarm emerges (disease ends)</p>",
      "collapsed": false
    },
    {
      "name": "Plant Spores",
      "actions": 1,
      "traits": [],
      "description": "<p>The spitting sawfly plants spores in an adjacent creature that's Paralyzed or Unconscious, exposing it to creeping sprout disease.</p>",
      "collapsed": false
    },
    {
      "name": "Seizing Venom",
      "actions": null,
      "traits": [
        "incapacitation",
        "poison"
      ],
      "description": "<p><strong>Saving Throw</strong> DC 29 Fortitude Saving Throw;</p>\n<p><strong>Maximum Duration</strong> 6 rounds</p>\n<p><strong>Stage 1</strong> Off-Guard and Slowed 1 (1 round)</p>\n<p><strong>Stage 2</strong> off-guard and Slowed 2 (1 round)</p>\n<p><strong>Stage 3</strong> Paralyzed (1 round)</p>",
      "collapsed": false
    }
