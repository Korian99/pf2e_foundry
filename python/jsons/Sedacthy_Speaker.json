    {
      "name": "Animal Shield",
      "actions": 1,
      "traits": [],
      "description": "<p><strong>Requirements</strong> The sedacthy speaker is adjacent to a Large or larger animal ally</p>\n<hr />\n<p><strong>Effect</strong> The speaker gains cover until the start of their next turn or when they're no longer adjacent to the animal, whichever comes first.</p>",
