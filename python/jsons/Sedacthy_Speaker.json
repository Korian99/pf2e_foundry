    {
      "name": "Painful Cry",
      "actions": 2,
      "traits": [
        "mental",
        "sonic"
      ],
      "description": "<p>The sedacthy shrieks across a range of painfully high tones, dealing 3d6 Sonic Damage|options:area-damage]{3d6 sonic damage and 1d6 mental damage} to all creatures in a 30ft Cone, with a Basic DC 23 Fortitude Saving Throw save. A creature that fails its save is Sickened 1.</p>",
      "collapsed": false
    },
    {
      "name": "Shared Feast",
      "actions": 2,
      "traits": [],
      "description": "<p>The sedacthy makes a jaws Strike. If it hits, an ally of their choice can spend a reaction to make a jaws Strike against the same target. Allies with beaks or similar attacks can use those instead of jaws.</p>",
      "collapsed": false
    },
    {
