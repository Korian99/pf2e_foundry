  "offensiveAbilities": [
    {
      "name": "Breath Weapon",
      "actions": 2,
      "traits": [],
      "description": "<p>The bronze dragon breathes in one of two ways.</p>\n<p>The dragon can't use Breath Weapon again for 1d4 rounds.</p><ul><li><strong>Lightning</strong> (arcane, electricity) The dragon breathes lightning in a 80ft Line that deals 8d12 Electricity Damage damage (Basic DC 33 Reflex Saving Throw save).</li><li><strong>Repulsion Gas</strong> (arcane, incapacitation, mental) The dragon breathes a 80ft Line of repulsive gas. Each creature in the area must succeed at a Basic DC 33 Will Saving Throw save or become Fleeing from the dragon for 1 round (or 2 rounds on a critical failure).</li></ul>",
      "collapsed": false
    },
    {
      "name": "Draconic Frenzy",
      "actions": 2,
      "traits": [],
      "description": "<p>The dragon makes two claw Strikes and one tail Strike in any order.</p>",
      "collapsed": false
    },
    {
      "name": "Draconic Momentum",
      "actions": null,
      "traits": [],
      "description": "<p>When the dragon scores a critical hit with a Strike, it recharges its Breath Weapon.</p>",
      "collapsed": false
    },
    {
      "name": "Water Mastery",
      "actions": null,
      "traits": [
        "arcane",
        "water"
      ],
      "description": "<p>For up to 60 minutes per day, the dragon, along with allied creatures and vessels within 50 feet, can move at double their normal Speed in water.</p>",
      "collapsed": false
    }
  ],
