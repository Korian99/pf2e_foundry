  "offensiveAbilities": [
    {
      "name": "Chthonic Mucus",
      "actions": 2,
      "traits": [
        "primal",
        "unholy"
      ],
      "description": "<p>The ocean drake spits a ball of chthonic mucus up to a range of 50 feet that explodes in a 10ft Burst. Creatures within the burst take 4d6 Spirit Damage damage (Basic DC 19 Reflex Saving Throw save). Those that fail this save also take 1d6 Persistent,spirit Damage and take a –5-foot status penalty to their Speed. This Speed reduction ends with the persistent spirit damage.</p>\n<p>The ocean drake can't use Chthonic Mucus again for 1d6 rounds.</p><hr /><p>Effect: Chthonic Mucus</p>",
      "collapsed": false
    },
    {
      "name": "Draconic Frenzy",
      "actions": 2,
      "traits": [],
      "description": "<p>The river drake makes one Fangs Strike and two Tail Strikes in any order.</p>",
      "collapsed": false
    },
    {
      "name": "Speed Surge",
      "actions": 1,
      "traits": [
        "move"
      ],
      "description": "<p><strong>Frequency</strong> three times per day;</p>\n<hr />\n<p><strong>Effect</strong> The river drake Strides or Flies twice.</p>",
      "collapsed": false
    }
  ],
