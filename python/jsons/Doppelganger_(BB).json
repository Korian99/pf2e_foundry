    {
      "name": "Change Shape",
      "actions": 1,
      "traits": [
        "arcane",
        "concentrate",
        "polymorph"
      ],
      "description": "<p>The doppelganger takes on the specific appearance of any Small or Medium humanoid it has seen. This doesn't change the doppelganger's Stride speed or their attack and damage bonuses with their Strikes, but it might change the damage type their Strikes deal (typically to bludgeoning).</p>",
      "collapsed": false
    },
    {
      "name": "Mind Reading",
      "actions": 2,
      "traits": [
        "arcane",
        "manipulate"
      ],
      "description": "<p>The doppelganger attempts to read the surface thoughts of one creature within 30 feet. The target resists if it succeeds at a DC 21 Will Saving Throw save.</p>",
      "collapsed": false
    }
