  "offensiveAbilities": [
    {
      "name": "Breath Weapon",
      "actions": 2,
      "traits": [
        "arcane",
        "fire"
      ],
      "description": "<p>The construct breathes in one of two ways, then can't use Breath Weapon again for 1d4 rounds.</p>\n<p>- Flame (arcane, evocation, fire) A blast of flame deals 15d10 Fire Damage damage to all creatures in a 60ft Cone (Basic DC 45 Reflex Saving Throw save). This fire damage does not harm objects or constructs.</p>\n<p>- Weakening Gas (arcane, necromancy) A cloud of gold-flecked gas forces each creature in a 60ft Cone to attempt a Basic DC 45 Fortitude Saving Throw save; the effect lasts 1 minute.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature is Enfeebled 2.</p>\n<p><strong>Failure</strong> The creature is Enfeebled 5.</p>\n<p><strong>Critical Failure</strong> The creature is Enfeebled 8.</p>",
      "collapsed": false
    },
    {
      "name": "Reverberating Revenge",
      "actions": -1,
      "traits": [
        "arcane",
        "fire"
      ],
      "description": "<p><strong>Trigger</strong> The dragonshard guardian takes cold, fire, electricity, or sonic damage from a non-dragonshard guardian source</p>\n<hr />\n<p><strong>Effect</strong> The dragonshard guardian's body absorbs the energy entirely, preventing the damage from harming the construct. Its body reverberates and transforms the absorbed energy before projecting it outward in a 60ft Burst.</p>\n<p>Each creature within the burst takes an amount of fire damage equal to the amount of energy damage absorbed by the triggering attack, including any damage resisted by the guardian's resistances and additional damage from its weakness (Basic DC 45 Reflex Saving Throw save).</p>\n<p>This fire damage doesn't harm objects or constructs.</p>",
      "collapsed": false
    }
  ],
