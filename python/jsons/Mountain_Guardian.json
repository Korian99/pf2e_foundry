  "offensiveAbilities": [
    {
      "name": "Base Kinesis",
      "actions": 2,
      "traits": [],
      "description": "<p>The mountain guardian generates, moves, or suppresses up to 1 Bulk of naturally occurring earthen matter within 15 feet. Generating creates earthen matter, moving moves existing matter up to 20 feet into any direction, and suppressing destroys a piece of that element (which can't be a durable crafted good, only natural forms of the element).</p>",
      "collapsed": false
    },
    {
      "name": "Channel Elements",
      "actions": 1,
      "traits": [
        "primal"
      ],
      "description": "<p>The mountain guardian reactivates their kinetic aura and can make an elemental blast Strike.</p>",
      "collapsed": false
    },
    {
      "name": "Empowered Blast",
      "actions": 2,
      "traits": [],
      "description": "<p>The mountain guardian makes a melee or ranged elemental blast Strike with a +4 status bonus to damage.</p>",
      "collapsed": false
    },
    {
      "name": "Tremor",
      "actions": 2,
      "traits": [
        "concentrate",
        "earth",
        "impulse",
        "overflow",
        "primal"
      ],
      "description": "<p>The mountain guardian stomps on natural earth or stone, causing a localized tremor. All creatures in a 10ft Type:burst within 30 feet take 3d10 Bludgeoning Damage damage with a Basic DC 24 Fortitude Saving Throw save. A creature that critically fails is knocked Prone. Earth and stone in the area is difficult terrain until the start of the mountain guardian's next turn.</p>",
      "collapsed": false
    }
