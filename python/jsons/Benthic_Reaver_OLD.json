  "offensiveAbilities": [
    {
      "name": "Numbing Ice",
      "actions": null,
      "traits": [
        "cold"
      ],
      "description": "<p>A creature who takes damage from the benthic reaver's eye beam Strike must succeed at a DC 41 Fortitude Saving Throw save or become Slowed 2 as cold stiffens its limbs. A flying creature who fails its save also descends safely to the ground below. This is forced movement.</p>",
      "collapsed": false
    },
    {
      "name": "Song of the Lost",
      "actions": 1,
      "traits": [
        "arcane",
        "auditory",
        "emotion",
        "fear",
        "mental"
      ],
      "description": "<p>The benthic reaver unleashes a cry of mourning. All creatures within 60 feet must attempt a DC 41 Will Saving Throw save to resist. The benthic reaver can't use Song of the Lost for 1d4 rounds.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature is Frightened 1.</p>\n<p><strong>Failure</strong> The creature is Frightened 2.</p>\n<p><strong>Critical Failure</strong> As failure, but the creature is also Stunned 1 with sympathy.</p>",
      "collapsed": false
    },
    {
      "name": "Tail Sweep",
      "actions": 2,
      "traits": [],
      "description": "<p>The benthic reaver makes a tail Strike against each enemy within its reach. These attacks count toward the benthic reaver's multiple attack penalty, but the multiple attack penalty doesn't increase until after the benthic reaver makes all its attacks.</p>",
      "collapsed": false
    },
    {
      "name": "Improved Knockdown",
      "actions": 0,
      "traits": [],
      "description": "<p><details><summary>See rules...</summary>\n<p><p><strong>Requirements</strong> The monster's last action was a successful Strike that lists Improved Knockdown in its damage entry</p><hr /><p><strong>Effect</strong> The monster attempts to Trip the creature as a free action. This attempt neither applies nor counts toward the monster's multiple attack penalty.</p></p></details></p>",
      "collapsed": false
    }
  ],
