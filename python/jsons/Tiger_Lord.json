    {
      "name": "Closing Volley",
      "actions": 3,
      "traits": [],
      "description": "<p>The Tiger Lord makes a ranged Strike with a hatchet, then Strides up to twice its speed. If it ends its movement within melee reach of the target of its ranged Strike, it may make a melee Strike against that enemy. If the ranged Strike hit the target, the target is Off-Guard against the melee Strike.</p>",
      "collapsed": false
    },
    {
      "name": "Vengeful Rage",
      "actions": -1,
      "traits": [],
      "description": "<p><strong>Requirements</strong> The Tiger Lord is not Fatigued or already in a rage</p>\n<p><strong>Trigger</strong> The Tiger Lord suffers damage that reduces its Hit Points to 100 or less.</p>\n<p><strong>Effect</strong> The Tiger Lord flies into a rage that lasts 1 minute. While raging, the Tiger Lord gains a +1 status bonus to attack rolls, gains a +2 status bonus to damage rolls, and takes a -2 status penalty to AC. After the rage, the Tiger Lord is fatigued.</p>",
      "collapsed": false
    }
