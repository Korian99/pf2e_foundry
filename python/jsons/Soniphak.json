    {
      "name": "Disruptive Screech",
      "actions": -1,
      "traits": [],
      "description": "<p><strong>Trigger</strong> A creature within 30 feet of the soniphak uses an auditory action</p>\n<hr />\n<p><strong>Effect</strong> The soniphak makes a screech Strike against the triggering creature. This disrupts a triggering concentrate action if the Strike is a critical hit.</p>",
      "collapsed": false
    },
    {
      "name": "Shattering Scream",
      "actions": 2,
      "traits": [
        "sonic"
      ],
      "description": "<p>The soniphak can focus its screech at a stone or rock surface within 60 feet to create an explosion in a 15ft Burst from the point of impact. Creatures in the area take 5d6 Piercing Damage damage (Basic DC 28 Reflex Saving Throw save), and the area becomes difficult terrain due to fragments of loose stone.</p>",
