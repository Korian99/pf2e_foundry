    {
      "name": "Dazzling Display",
      "actions": 2,
      "traits": [
        "mental",
        "primal",
        "visual"
      ],
      "description": "<p>The emperor bird flaps its mesmerizing wings. Each creature within 15 feet that can see the emperor bird must attempt a DC 19 Will Saving Throw save.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature is Dazzled for 1 round.</p>\n<p><strong>Failure</strong> The creature is dazzled for 1d4 rounds.</p>\n<p><strong>Critical Failure</strong> The creature is Confused for 1d4 rounds.</p>",
