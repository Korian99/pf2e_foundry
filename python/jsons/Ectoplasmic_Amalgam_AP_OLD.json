  "offensiveAbilities": [
    {
      "name": "Overwhelming Ectoplasm",
      "actions": null,
      "traits": [],
      "description": "<p>An ectoplasmic amalgam's Strikes affect incorporeal creatures with the effects of a <em>Ghost Touch</em> property rune. A creature damaged by an ectoplasmic amalgam's Strikes is Stunned 1 unless they succeed at a DC 36 Fortitude Saving Throw save, as the thoughts and emotions of the amalgam's constituent souls invade their mind.</p>",
      "collapsed": false
    },
    {
      "name": "Pummeling Barrage",
      "actions": 3,
      "traits": [],
      "description": "<p>The ectoplasmic amalgam attempts a melee Strike against each enemy within the amalgam's melee reach. Each attack counts toward the amalgam's multiple attack penalty but don't increase the amalgam's penalty until it has made all its attacks.</p>",
      "collapsed": false
    },
    {
      "name": "Spew Ectoplasm",
      "actions": 2,
      "traits": [
        "divine"
      ],
      "description": "<p>The ectoplasmic amalgam releases a burst of ectoplasm that deals 16d6 Bludgeoning Damage damage in a 60ft Cone (Basic DC 36 Reflex Saving Throw). On a failed save, a creature is additionally Stunned 1 (or Stunned 2 on a critical failure). Spew Ectoplasm functions as a force effect for the purposes of affecting incorporeal creatures. The ectoplasmic amalgam can't use Spew Ectoplasm again for 1d4 rounds.</p>",
      "collapsed": false
    }
  ],
