  "offensiveAbilities": [
    {
      "name": "Crooning Cry",
      "actions": 2,
      "traits": [
        "incapacitation",
        "mental",
        "primal"
      ],
      "description": "<p>60 feet. The rompo hums in a low voice. Each creature within the emanation must succeed at a DC 19 Will Saving Throw save or become Fascinated and compelled to move away from the rompo, traveling to the furthest edge of the emanation. Fascinated creatures are also Off-Guard.</p>\n<p>The effect lasts for 1 round, but if the rompo spends a single action on subsequent rounds, it can extend the duration by 1 round for all affected creatures. If the rompo attacks, the fascinated condition ends only for the creature that is attacked.</p>\n<p>On a successful save, a creature is temporarily immune to Crooning Cry for 24 hours.</p>",
      "collapsed": false
    },
    {
      "name": "Rompo Chills",
      "actions": null,
      "traits": [
        "disease"
      ],
      "description": "<p>The target can't reduce its sickened condition while affected by rompo chills</p>\n<p><strong>Saving Throw</strong> DC 19 Fortitude Saving Throw</p>\n<p><strong>Onset</strong> 1 day</p>\n<hr />\n<p><strong>Stage 1</strong> Clumsy 1 (1 day)</p>\n<p><strong>Stage 2</strong> Clumsy 1 and Sickened 1 (1 day)</p>\n<p><strong>Stage 3</strong> Clumsy 2 and Sickened 2 (1 day)</p>\n<p><strong>Stage 4</strong> Unconscious (1 day)</p>\n<p><strong>Stage 5</strong> dead</p>",
      "collapsed": false
    }
  ],
