      "actions": 2,
      "traits": [],
      "description": "<p>Old Crackjaw makes a jaws Strike against an object. This counts as two attacks when calculating Old Crackjaw's multiple attack penalty. If this Strike hits, Old Crackjaw deals an extra die of weapon damage to the object.</p>",
      "collapsed": false
    },
