  "offensiveAbilities": [
    {
      "name": "Shade Breath",
      "actions": 2,
      "traits": [
        "arcane",
        "void"
      ],
      "description": "<p>The shadow scamp creates a blast of clinging shadows in a 15ft Type:cone that deal 2d4 Void Damage damage to each creature within the area (Basic DC 16 Reflex Saving Throw save). A creature that fails its save is also Dazzled for 1 round. The shadow scamp can't use Shade Breath again for 1d4 rounds.</p>",
      "collapsed": false
    },
    {
      "name": "Shadow Jump",
      "actions": 3,
      "traits": [
        "arcane",
        "shadow",
        "teleportation"
      ],
      "description": "<p><strong>Requirements</strong> The shadow scamp is in dim light or darkness</p><hr /><p><strong>Effect</strong> The shadow scamp recedes into darkness and instantly teleports to a square of dim light or darkness within 60 feet. This movement doesn't trigger reactions.</p>",
      "collapsed": false
    }
