  "offensiveAbilities": [
    {
      "name": "Caustic Mucus",
      "actions": 2,
      "traits": [
        "acid",
        "arcane"
      ],
      "description": "<p>Ahrkinos spits a ball of caustic mucus up to a range of 50 feet that explodes in a 10ft Burst. Creatures within the burst take 5d6 Acid Damage damage (Basic DC 20 Reflex Saving Throw save). Those that fail this save also take 1d6 Persistent,acid Damage damage and take a –5-foot status penalty to their Speed. This Speed reduction ends with the persistent acid damage.</p>\n<p>Ahrkinos can't use Caustic Mucus again for 1d6 rounds.</p>",
      "collapsed": false
    },
    {
      "name": "Draconic Frenzy",
      "actions": 2,
      "traits": [],
      "description": "<p>Ahrkinos makes one fangs Strike and two tail Strikes in any order.</p>",
      "collapsed": false
    },
    {
      "name": "Old Bones",
      "actions": null,
      "traits": [],
      "description": "<p>Ahrkinos's age has left him infirm and makes it difficult for him to fly. Ahrkinos becomes Fatigued if he uses more than one Fly action to fly in a single round. His Speed Surge is considered one Fly action for this purpose. In addition, he immediately begins to fall at the end of his turn if he is flying, but treats the fall as 40 feet shorter.</p>",
      "collapsed": false
    },
    {
      "name": "Speed Surge",
      "actions": 1,
      "traits": [
        "move"
      ],
      "description": "<p>Ahrkinos moves up to twice his Speed. He can do this three times per day.</p>",
      "collapsed": false
    }
