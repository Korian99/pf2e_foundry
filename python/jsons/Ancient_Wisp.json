  "offensiveAbilities": [
    {
      "name": "Feed on Fear",
      "actions": 1,
      "traits": [
        "concentrate"
      ],
      "description": "<p><strong>Requirement</strong> An enemy is under a fear effect or Dying within 15 feet of the will-o'-wisp.</p>\n<hr />\n<p><strong>Effect</strong> The will-o'wisp feeds on the creature's terror. It regains 2d8 Healing Damage Hit Points, and if it has Gone Dark, its glow reignites.</p>\n<p>A will-o'-wisp can take this action only once per round.</p>",
      "collapsed": false
    },
    {
      "name": "Go Dark",
      "actions": 1,
      "traits": [
        "concentrate"
      ],
      "description": "<p>The will-o'-wisp extinguishes its glow, becoming Invisible. It can end this effect with another use of this action. If it uses its shock attack while invisible, the arc of electricity lets any observer determine its location, making the will-o'-wisp only Hidden to all observers until it moves.</p>",
      "collapsed": false
    }
