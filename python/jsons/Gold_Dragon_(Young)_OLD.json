  "offensiveAbilities": [
    {
      "name": "Breath Weapon",
      "actions": 2,
      "traits": [],
      "description": "<p>The gold dragon breathes in one of two ways.</p>\n<p>The dragon can't use Breath Weapon again for 1d4 rounds.</p><ul><li><strong>Flame</strong> (arcane, fire) The dragon breathes a blast of flame in a 30ft Cone that deals 11d6 Fire Damage damage (Basic DC 31 Reflex Saving Throw save).</li><li><strong>Weakening Gas</strong> (arcane) The dragon breathes a blast of weakening gas. Each creature within a 30ft Cone must succeed at a Basic DC 31 Fortitude Saving Throw save or become Enfeebled 1 for 1 minute (or Enfeebled 2 on a critical failure).</li></ul>",
      "collapsed": false
    },
    {
      "name": "Draconic Frenzy",
      "actions": 2,
      "traits": [],
      "description": "<p>The gold dragon makes two claw Strikes and one horns Strike in any order.</p>",
      "collapsed": false
    },
    {
      "name": "Draconic Momentum",
      "actions": null,
      "traits": [],
      "description": "<p>When the gold dragon scores a critical hit with a Strike, it recharges Breath Weapon.</p>",
      "collapsed": false
    }
