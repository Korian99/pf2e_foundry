  "offensiveAbilities": [
    {
      "name": "Crystalline Dust Form",
      "actions": 1,
      "traits": [
        "polymorph"
      ],
      "description": "<p>The axiomite shifts their form to a cloud of crystalline dust in which strange symbols and equations flash.</p>\n<p>They gain a fly Speed of 40 feet and can fit through even tiny apertures, similar to vapor form. They can cast spells but can't make melee or ranged attacks.</p>\n<p>The axiomite can Dismiss this form to return to humanoid form.</p>",
      "collapsed": false
    }
  ],
