  "offensiveAbilities": [
    {
      "name": "Breath Weapon",
      "actions": 2,
      "traits": [
        "divine"
      ],
      "description": "<p>The Azmakian effigy exhales rusting gas in a 15ft Cone. The gas deals 2d6 Untyped Damage damage to the highest-level metal item carried by every creature in the area, ignoring these items' Hardness (Basic DC 22 Fortitude Saving Throw); unattended metal items in the area take this damage automatically. The Azmakian effigy can't use its Breath Weapon again for 1d4 rounds.</p>",
      "collapsed": false
    },
    {
      "name": "Powerful Charge",
      "actions": 2,
      "traits": [],
      "description": "<p>The Azmakian effigy Strides twice and then makes a horn Strike. If it moved at least 20 feet from its starting position, the Strike's damage is increased to (3d10+10) Piercing Damage damage.</p>",
