    {
      "name": "Heft Crate",
      "actions": 2,
      "traits": [
        "manipulate"
      ],
      "description": "<p><strong>Requirements</strong> The dockhand is adjacent to a crate</p>\n<hr />\n<p><strong>Effect</strong> The dockhand picks up a crate and heaves it up to 15 feet. Upon landing, the crate breaks open in a 5ft Burst. Each creature within the area takes 2d6 Bludgeoning Damage damage (Basic DC 13 Reflex Saving Throw save), and the area becomes difficult terrain until cleared.</p>",
      "collapsed": false
    },
    {
      "name": "Swig",
      "actions": 2,
      "traits": [
        "manipulate"
      ],
      "description": "<p>The dockhand Interacts to either draw a bottle of Alcohol or pick up a nearby unattended bottle of alcohol and drink the whole thing.</p>\n<p>For 1 minute, the dockhand gains a +2 item bonus to melee damage rolls and saving throws against fear, but they become Clumsy 1.</p>",
