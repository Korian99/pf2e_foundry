  "offensiveAbilities": [
    {
      "name": "Pack Attack",
      "actions": null,
      "traits": [],
      "description": "<p>A kholo pragmatist deals 1d4 extra damage to any creature that's within reach of at least two of the kholo pragmatist's allies.</p>",
      "collapsed": false
    },
    {
      "name": "Pragmatic Aid",
      "actions": 1,
      "traits": [
        "concentrate",
        "visual"
      ],
      "description": "<p><strong>Requirements</strong> The kholo pragmatist is adjacent to a foe</p><hr /><p><strong>Effect</strong> The kholo pragmatist sets up an advantageous avenue of attack for an ally within 10 feet of the same foe and then Steps away from that foe. The foe is Off-Guard to the kholo pragmatist's ally's next attack.</p>",
      "collapsed": false
    },
    {
      "name": "Rugged Travel",
      "actions": null,
      "traits": [],
      "description": "<p>A kholo ignores the first square of difficult terrain they move into each time they Step or Stride.</p>",
      "collapsed": false
    },
    {
      "name": "Spear Parry",
      "actions": 1,
      "traits": [],
      "description": "<p><strong>Requirements</strong> The kholo pragmatist is wielding a longspear</p><hr /><p><strong>Effect</strong> The kholo pragmatist positions their spear defensively, gaining a +1 circumstance bonus to AC until the start of their next turn.</p>",
      "collapsed": false
    }
