    {
      "name": "Grave Blight",
      "actions": null,
      "traits": [
        "disease"
      ],
      "description": "<p><strong>Saving Throw</strong> DC 19 Fortitude Saving Throw</p>\n<p><strong>Stage 1</strong> carrier with no ill effect (1 day)</p>\n<p><strong>Stage 2</strong> 1d6 Poison Damage damage, Sickened 1 (1 day)</p>\n<p><strong>Stage 3</strong> 1d8 Poison Damage damage, every hour the victim must succeed at another Fortitude save or be Confused for 1 minute, Sickened 2 (1 day)</p>",
      "collapsed": false
    },
    {
      "name": "Mocking Cry",
      "actions": 1,
      "traits": [
        "auditory"
      ],
      "description": "<p>The Karina mimics a voice and mocks a creature within 30 feet. They attempt a Deception check to Demoralize the creature.</p>\n<p>Regardless of whether the check succeeds, the target creature is temporarily immune to the Karina's Mocking Cry for 1 hour.</p>",
      "collapsed": false
    },
    {
      "name": "Grab",
      "actions": 1,
      "traits": [],
      "description": "<p><details><summary>See rules...</summary>\n<p><p><strong>Requirements</strong> The monster's last action was a successful Strike that lists Grab in its damage entry, or the monster has a creature Grabbed or Restrained</p><hr /><p><strong>Effect</strong> If used after a Strike, the monster attempts to Grapple the creature using the body part it attacked with. This attempt neither applies nor counts toward the creature's multiple attack penalty.</p><p>The monster can instead use Grab and choose one creature it's grabbing or restraining with an appendage that has Grab to automatically extend that condition to the end of the monster's next turn.</p></p></details></p>",
      "collapsed": false
    }
