  "offensiveAbilities": [
    {
      "name": "Arrogant Taunts",
      "actions": 1,
      "traits": [
        "auditory",
        "emotion",
        "fear",
        "mental"
      ],
      "description": "<p>The eberark utters crude insults and growls threateningly. Each creature within 30 feet must attempt a DC 27 Will Saving Throw save.</p>\n<p>The creature is then temporarily immune for 10 minutes.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature is Frightened 1.</p>\n<p><strong>Failure</strong> The creature is Frightened 2 and Paralyzed for 1 round.</p>\n<p><strong>Critical Failure</strong> The creature is Frightened 4 and paralyzed for 1d4 rounds.</p>",
      "collapsed": false
    },
    {
      "name": "Incendiary Spit",
      "actions": null,
      "traits": [],
      "description": "<p>A creature hit by the eberark's spit becomes coated in a slippery, flammable oil.</p>\n<p>The creature must succeed at a DC 27 Reflex Saving Throw save or become Clumsy 2 for as long as they are coated in incendiary spit.</p>\n<p>Creatures affected by incendiary spit that take fire damage catch fire, taking 3d6 Persistent,fire Damage damage. Once this persistent fire damage ends, the spit has burned away.</p>",
      "collapsed": false
    },
    {
      "name": "Trail of Flame",
      "actions": 2,
      "traits": [
        "fire"
      ],
      "description": "<p>The eberark Strides twice, leaving a trail of magical fire behind it as it moves. Squares the eberark moves through catch fire, creating a 5-foot-tall wall of flame that burns for 1 round. The wall of flame conceals creatures and objects on the other side of it.</p>\n<p>Any creature that enters or starts its turn in the wall of flame takes 6d6 Fire Damage damage (Basic DC 27 Reflex Saving Throw save).</p>",
      "collapsed": false
    }
  ],
