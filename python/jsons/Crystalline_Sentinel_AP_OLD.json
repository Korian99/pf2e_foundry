  "offensiveAbilities": [
    {
      "name": "Claw Frenzy",
      "actions": 2,
      "traits": [],
      "description": "<p>The Crystalline Sentinel makes three claw Strikes; no more than two can be against the same target. These attacks count toward it's multiple attack penalty, but the penalty doesn't increase until after all the attacks have been made.</p>",
      "collapsed": false
    },
    {
      "name": "Crystal Corruption",
      "actions": null,
      "traits": [
        "arcane",
        "curse",
        "incapacitation"
      ],
      "description": "<p>Creatures afflicted by this curse slowly turn to solid crystal. This affliction's sickened, slowed, and paralyzed conditions can't be removed until the affliction itself is removed. Creatures with both the earth and elemental traits instead become carriers and suffer no ill effects aside from gaining the weakness to sonic.</p>\n<p><strong>Saving Throw</strong> DC 30 Fortitude Saving Throw</p>\n<p><strong>Stage 1</strong> sickened 1 (1 hour)</p>\n<p><strong>Stage 2</strong> weakness 5 to sonic and Sickened 1 (1 day)</p>\n<p><strong>Stage 3</strong> weakness 5 to sonic and Slowed 1 (1 day)</p>\n<p><strong>Stage 4</strong> weakness 10 to sonic and Paralyzed (1 day)</p>\n<p><strong>Stage 5</strong> weakness 10 to sonic, and the creature is permanently Petrified.</p>",
      "collapsed": false
    },
    {
      "name": "Crystal Splinter",
      "actions": null,
      "traits": [],
      "description": "<p>On a critical hit with a claw Strike, the crystalline sentinel inflicts 2d6 Persistent,bleed Damage damage.</p>",
      "collapsed": false
    },
    {
      "name": "Earth Glide",
      "actions": null,
      "traits": [],
      "description": "<p>The xorn can Burrow through any earthen matter, including rock. When it does so, the xorn moves at its full burrow Speed, leaving no tunnels or signs of its passing.</p>",
      "collapsed": false
    }
  ],
