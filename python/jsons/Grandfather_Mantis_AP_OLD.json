      "actions": -1,
      "traits": [],
      "description": "<p><strong>Trigger</strong> A creature within Grandfather Mantis's reach is hit by an ally's melee attack</p>\n<hr />\n<p><strong>Effect</strong> Grandfather Mantis makes a claw Strike against the triggering creature.</p>",
