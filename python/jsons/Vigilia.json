    {
      "name": "Electrical Purge",
      "actions": 2,
      "traits": [
        "divine",
        "electricity",
        "nonlethal"
      ],
      "description": "<p>The vigilia releases lightning from their body in a 30ft Type:emanation dealing 4d10 Electricity Damage damage (Basic DC 30 Refex  save) to all creatures that aren't aeons or constructs. The vigilia is then Slowed 1 for 1 round.</p>",
      "collapsed": false
    },
    {
      "name": "Lightning Chain",
      "actions": 1,
      "traits": [
        "divine",
        "electricity",
        "nonlethal"
      ],
      "description": "<p>The vigilia wraps momentary chains of electrical energy around a creature within 60 feet, dealing 2d10 Electricity Damage damage (Basic DC 30 Refex  save). A creature that fails its save is also pulled 10 feet toward the vigilia (20 feet on a critical failure).</p>",
      "collapsed": false
    },
    {
      "name": "Take Prisoner",
      "actions": 1,
      "traits": [],
      "description": "<p>The vigilia Interacts to pick up a Medium or smaller Unconscious creature within its reach, then Strides.</p>",
      "collapsed": false
    }
