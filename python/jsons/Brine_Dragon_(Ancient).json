  "offensiveAbilities": [
    {
      "name": "Bathygenic Barrage",
      "actions": 2,
      "traits": [
        "primal"
      ],
      "description": "<p><strong>Frequency</strong> once per day</p><hr /><p><strong>Effect</strong> The dragon uses Pressurized Pool three times. None of the bursts can overlap.</p>",
      "collapsed": false
    },
    {
      "name": "Benthic Bite",
      "actions": null,
      "traits": [
        "primal"
      ],
      "description": "<p>A creature who takes damage from a brine dragon's jaws Strike must succeed at a DC 35 Fortitude Saving Throw save or be Enfeebled 2 for 1 round.</p>",
      "collapsed": false
    },
    {
      "name": "Crushing Breath",
      "actions": 2,
      "traits": [
        "primal"
      ],
      "description": "<p>The dragon spews a 100ft Type:line of pressurized water that deals 18d6 Bludgeoning Damage damage with a Basic DC 38 Reflex Saving Throw save. A creature that fails the save is also Clumsy 1 (Clumsy 2 on a critical failure) for 1 minute. The dragon can't use Crushing Breath again for 1d4 rounds.</p>",
      "collapsed": false
    },
    {
      "name": "Draconic Frenzy",
      "actions": 2,
      "traits": [],
      "description": "<p>The dragon makes two claw Strikes and one tail Strike in any order.</p>",
      "collapsed": false
    },
    {
      "name": "Draconic Momentum",
      "actions": null,
      "traits": [],
      "description": "<p>When the dragon scores a critical hit with a Strike, they recharge Crushing Breath.</p>",
      "collapsed": false
    },
    {
      "name": "Pressurized Pool",
      "actions": 2,
      "traits": [
        "primal"
      ],
      "description": "<p>The dragon expels a 10ft Type:burst of pressurized water within 120 feet that lasts for 1 minute. A creature other than a brine dragon that enters or begins their turn within a burst must succeed at a DC 38 Fortitude Saving Throw save or become encumbered until the beginning of their next turn.</p>",
      "collapsed": false
    },
    {
      "name": "Tidal Surge",
      "actions": 2,
      "traits": [
        "primal"
      ],
      "description": "<p>The dragon sweeps their wings, creating a 30ft Type:cone of buffeting water that deals 12d8 Bludgeoning Damage damage with a Basic DC 38 Fortitude Saving Throw save. Each unattended object and each creature that fails the save is also pushed away from the dragon 20 feet (30 feet on a critical failure) and is knocked Prone. The dragon can't use Tidal Surge again for 1d4 rounds.</p>",
      "collapsed": false
    }
  ],
