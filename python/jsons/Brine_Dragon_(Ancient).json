  "offensiveAbilities": [
    {
      "name": "Breath Weapon",
      "actions": 2,
      "traits": [
        "acid",
        "primal"
      ],
      "description": "<p>The dragon breathes a spray of acidic salt water that deals 18d6 Acid Damage damage in a 120ft Line (Basic DC 38 Reflex Saving Throw save).</p>\n<p>They can't use Breath Weapon again for 1d4 rounds.</p>",
      "collapsed": false
    },
    {
      "name": "Capsize",
      "actions": 1,
      "traits": [
        "attack"
      ],
      "description": "<p>The dragon tries to capsize an adjacent aquatic vessel of their size or smaller. They must succeed at an Athletics check with a DC of 35 (reduced by 5 for each size smaller the vessel is than the dragon) or the pilot's Sailing Lore DC, whichever is higher.</p>",
      "collapsed": false
    },
    {
      "name": "Desiccating Bite",
      "actions": 2,
      "traits": [],
      "description": "<p>The dragon makes a jaws Strike. On a hit, the target takes 6d6 Persistent,acid Damage damage, and is Sickened 3 from the pain of salt and brine in its wounds.</p>",
      "collapsed": false
    },
    {
      "name": "Draconic Frenzy",
      "actions": 2,
      "traits": [],
      "description": "<p>The dragon makes two claw Strikes and one wing Strike in any order.</p>",
      "collapsed": false
    },
    {
      "name": "Draconic Momentum",
      "actions": null,
      "traits": [],
      "description": "<p>The dragon recharges their Breath Weapon whenever they score a critical hit with a Strike.</p>",
      "collapsed": false
    },
    {
      "name": "Painful Strikes",
      "actions": null,
      "traits": [
        "acid"
      ],
      "description": "<p>The brine dragon's body is encrusted with salty, acidic crystals. When a target takes damage from one of the dragon's melee Strikes, it must succeed at a DC 38 Fortitude Saving Throw Save or be Stunned 1 (Stunned 3 on a critical failure). The target then becomes temporarily immune for 1 minute.</p>",
      "collapsed": false
    }
