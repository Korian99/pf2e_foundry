  "offensiveAbilities": [
    {
      "name": "Resin Crust",
      "actions": null,
      "traits": [
        "incapacitation",
        "poison"
      ],
      "description": "<p>A creature damaged by a resin-seep xulgath's jaws or claw Strike must succeed at a DC 28 Reflex Saving Throw save or be covered with clumps of noxious resin, taking 2d8 Poison Damage damage and a –15-foot penalty to its Speeds for 1 minute (on a critical failure, the creature is also Clumsy 1 for 1 minute). The creature is Sickened 1 for as long it has a Speed penalty. A creature can spend an Interact action to scrape the resin off, decreasing the Speed penalty by 5 with each such action.</p>",
      "collapsed": false
    },
    {
      "name": "Resin Spray",
      "actions": 2,
      "traits": [
        "poison"
      ],
      "description": "<p>The resin-seep xulgath flexes its pores and emits a 30ft Line of resin that deals 3d12 Poison Damage damage and knocks the target 5 feet back (Basic DC 28 Reflex Saving Throw save; on a success or critical success the target isn't knocked back, and on a critical failure the target is knocked back 10 feet). The resin-seep xulgath can't use Resin Spray again for 1d4 rounds.</p>",
      "collapsed": false
    },
    {
      "name": "Xulgath Bile",
      "actions": null,
      "traits": [
        "poison"
      ],
      "description": "<p><strong>Saving Throw</strong> DC 28 Fortitude Saving Throw</p>\n<p><strong>Maximum Duration</strong> 1 hour</p>\n<p><strong>Stage 1</strong> Fatigued (1 minute).</p>\n<p><strong>Stage 2</strong> Fatigued and Unconscious (1 minute).</p>\n<p><em><strong>Dev Note</strong>: Xulgath Bile is not included on this creature's original stat block except for the ranged dagger strike. We have included it here to allow GMs to choose to use it. It is a copy from Xulgath Bilebearer and the DC has been increased to match this level.</em></p>",
      "collapsed": false
    }
  ],
