  "offensiveAbilities": [
    {
      "name": "Drowning Hook",
      "actions": 1,
      "traits": [
        "primal",
        "water"
      ],
      "description": "<p><strong>Requirements</strong> A creature is Prone within the marsh giant's reach</p>\n<hr />\n<p><strong>Effect</strong> The marsh giant uses its gaff to push the creature down as water bubbles up below it. The target becomes submerged in water until they are no longer prone and must hold their breath if they cannot breathe water. They take 4d6 Bludgeoning Damage damage (Basic DC 23 Fortitude Saving Throw save) and lose 3 rounds worth of air if they fail the save.</p>",
      "collapsed": false
    },
    {
      "name": "Twist the Hook",
      "actions": 2,
      "traits": [],
      "description": "<p>The marsh giant makes a melee Strike with its gaff. If it hits, it twists and yanks the gaff to knock the target Prone and create an awful wound, dealing 2d6 Persistent,bleed Damage damage to the creature.</p>",
      "collapsed": false
    }
  ],
