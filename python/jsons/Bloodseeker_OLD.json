  "offensiveAbilities": [
    {
      "name": "Attach",
      "actions": null,
      "traits": [],
      "description": "<p>When a bloodseeker hits a target larger than itself, its barbed legs attach it to that creature. This is similar to grabbing the creature, but the bloodseeker moves with that creature rather than holding it in place.</p>\n<p>The bloodseeker is Off-Guard while attached. If the bloodseeker is killed or pushed away while attached to a creature it has drained blood from, that creature takes 1 Bleed Damage damage.</p>\n<p>Escaping the attach or removing the bloodseeker in other ways doesn't cause bleed damage.</p>",
      "collapsed": false
    },
    {
      "name": "Blood Drain",
      "actions": 1,
      "traits": [],
      "description": "<p><strong>Requirements</strong> The bloodseeker is attached to a creature.</p>\n<hr />\n<p><strong>Effect</strong> The bloodseeker uses its proboscis to drain blood from the creature it's attached to. This deals 1d4 damage, and the bloodseeker gains temporary Hit Points equal to the damage dealt.</p>\n<p>A creature that has its blood drained by a bloodseeker is Drained 1 until it receives healing (of any kind or amount).</p>",
      "collapsed": false
    }
  ],
