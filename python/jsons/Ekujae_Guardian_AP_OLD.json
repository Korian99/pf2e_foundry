  "offensiveAbilities": [
    {
      "name": "Double Slice",
      "actions": 2,
      "traits": [],
      "description": "<p>The Ekujae guardian makes two Strikes against the same target, one with each of their daggers. The guardian combines the damage of any attacks that hit and applies precision damage, resistance, and weaknesses only once. Both attacks count toward the guardian's multiple attack penalty, but the penalty increases only after both attacks.</p>",
      "collapsed": false
    },
    {
      "name": "Sneak Attack",
      "actions": null,
      "traits": [],
      "description": "<p>The ekujae guardian deals 1d6 extra precision damage to Off-Guard creatures.</p>",
      "collapsed": false
    },
    {
      "name": "Woodland Stride",
      "actions": null,
      "traits": [],
      "description": "<p>The Ekujae guardian ignores difficult terrain from plants.</p>",
      "collapsed": false
    }
