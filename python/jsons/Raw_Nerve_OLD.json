    {
      "name": "Float",
      "actions": null,
      "traits": [],
      "description": "<p>A raw nerve floats a few inches from the ground. As such, it can ignore difficult terrain.</p>",
      "collapsed": false
    },
    {
      "name": "Involuntary Reaction",
      "actions": null,
      "traits": [],
      "description": "<p>A creature struck by a raw nerve's nerve ending strike must succeed at a DC 26 Reflex Saving Throw saving throw or be unable to use reactions until the start of its next turn.</p>",
      "collapsed": false
    },
    {
      "name": "Synaptic Overload",
      "actions": 3,
      "traits": [
        "incapacitation",
        "mental",
        "occult"
      ],
      "description": "<p>The raw nerve releases a burst of mental energy in a 30ft Cone, dealing 4d12 Mental Damage damage to each creature in the cone (DC 23 Will Saving Throw save).</p>\n<hr />\n<p><strong>Critical Success</strong> The creature takes no damage.</p>\n<p><strong>Success</strong> The creature takes half damage.</p>\n<p><strong>Failure</strong> The creature takes full damage and is Stunned 1.</p>\n<p><strong>Critical Failure</strong> The creature takes double damage and is Stunned 2</p>",
      "collapsed": false
    }
