  "offensiveAbilities": [
    {
      "name": "Accelerating Inquest",
      "actions": 1,
      "traits": [
        "concentrate",
        "detection",
        "occult"
      ],
      "description": "<p>The raw nerve mentally probes a creature within 100 feet, attempting an occultism|defense:will check against the creature's Will DC. On a success, the raw nerve can Step, and gains a +2 circumstance bonus to AC against that creature until the start of the raw nerve's next turn.</p>",
      "collapsed": false
