    {
      "name": "Earth Shaker",
      "actions": null,
      "traits": [
        "move"
      ],
      "description": "<p>Each turn, the first time the duneshaker solifugid is adjacent to a Large or smaller creature during a move action it's using, that creature must succeed at a DC 39 Reflex Saving Throw save or fall Prone.</p>",
      "collapsed": false
    },
    {
      "name": "Pounce",
      "actions": 1,
      "traits": [],
      "description": "<p>The duneshaker solifugid Strides and makes a Strike at the end of that movement. If the duneshaker solifugid began this action Hidden, it remains hidden until after this ability's Strike.</p>",
      "collapsed": false
    },
    {
      "name": "Rend",
      "actions": 1,
      "traits": [],
      "description": "<p>Claw</p>\n<hr />\n<p><details><summary>See rules...</summary>\n<p><p>A Rend entry lists a Strike the monster has.</p>\n<p><strong>Requirements</strong> The monster hit the same enemy with two consecutive Strikes of the listed type in the same round.</p>\n<hr />\n<p><strong>Effect</strong> The monster automatically deals that Strike's damage again to the enemy.</p></p></details></p>",
      "collapsed": false
    },
    {
      "name": "Venom Spray",
      "actions": 2,
      "traits": [
        "poison"
      ],
      "description": "<p>The duneshaker solifugid spews toxic barbs at all creatures in a 30ft Cone. Each creature within the area takes 10d6 Poison Damage damage (Basic DC 39 Fortitude Saving Throw save). A creature that fails its saving throw is Blinded for 1d6 rounds (or permanently on a critical failure).</p>\n<p>The duneshaker solifugid can't use Venom Spray again for 1d4 rounds.</p>",
      "collapsed": false
    }
