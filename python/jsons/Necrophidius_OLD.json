  "offensiveAbilities": [
    {
      "name": "Dance of Death",
      "actions": 3,
      "traits": [
        "mental",
        "occult",
        "visual"
      ],
      "description": "<p>The necrophidius sways, its serpentine form undulating and clattering in a hypnotic rhythm. Each creature that witnesses the dance must attempt a DC 18 Will Saving Throw save.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected and is temporarily immune for 24 hours.</p>\n<p><strong>Success</strong> The creature is unnerved by the swaying and becomes Off-Guard until the end of the necrophidius's next turn.</p>\n<p><strong>Failure</strong> The creature is distracted by the swaying, becoming Stunned 1. After it recovers, it is off-guard until the end of the necrophidius's next turn.</p>\n<p><strong>Critical Failure</strong> As failure, but Stunned 3.</p>",
      "collapsed": false
    },
    {
      "name": "Necrophidic Paralysis",
      "actions": null,
      "traits": [
        "incapacitation",
        "occult"
      ],
      "description": "<p>A living creature bitten by a necrophidius must succeed at a DC 20 Fortitude Saving Throw save or become Paralyzed. It can attempt a new save at the end of each of its turns, and the DC cumulatively decreases by 1 for each save attempted. A creature that succeeds at this save is temporarily immune to necrophidic paralysis for 24 hours.</p>",
      "collapsed": false
    }
  ],
