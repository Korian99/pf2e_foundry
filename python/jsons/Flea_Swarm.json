    {
      "name": "Flea Fever",
      "actions": null,
      "traits": [
        "disease"
      ],
      "description": "<p>Drain from flea fever can't be reduced or recovered from naturally until the disease is cured.</p>\n<p><strong>Saving Throw</strong> DC 19 Fortitude Saving Throw</p>\n<p><strong>Stage 1</strong> Drained 1 (1d4 hours)</p>\n<p><strong>Stage 2</strong> drained 1 and Sickened 1 (1 day)</p>\n<p><strong>Stage 3</strong> Drained 2 and sickened 1 (1 day)</p>\n<p><strong>Stage 4</strong> Drained 3 and sickened 1 (1 day)</p>\n<p><strong>Stage 5</strong> dead</p>",
      "collapsed": false
    },
    {
      "name": "Suck Blood",
      "actions": 1,
      "traits": [],
      "description": "<p><strong>Requirements</strong> The flea swarm's last action was Swarming Bites, and it dealt damage to at least one enemy</p><hr /><p><strong>Effect</strong> The flea swarm drinks the creatures' blood. Each victim becomes Drained 1 and the swarm regains 3 Healing Damage HP for each victim drained.</p>",
      "collapsed": false
    },
    {
      "name": "Swarming Bites",
      "actions": 1,
      "traits": [],
      "description": "<p>Each enemy in the swarm's space takes (2d4+7) Piercing Damage damage and must attempt a Basic DC 22 Reflex Saving Throw save. A creature that fails its save is exposed to flea fever.</p>",
