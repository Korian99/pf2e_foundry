    {
      "name": "Putrid Blast",
      "actions": 2,
      "traits": [
        "olfactory",
        "poison"
      ],
      "description": "<p><strong>Frequency</strong> once per minute</p>\n<hr />\n<p><strong>Effect</strong> All adjacent creatures must attempt a DC 18 Fortitude Saving Throw save. On a failure, the creature is Slowed 1 (Slowed 2 on a critical failure) until the end of its next turn and takes a -2 circumstance penalty to Fortitude saves against xulgath bile for 1 minute.</p>\n<p>Effect: Putrid Blast</p>",
      "collapsed": false
    },
    {
      "name": "Xulgath Bile",
      "actions": null,
      "traits": [
        "poison"
      ],
      "description": "<p><strong>Saving Throw</strong> DC 16 Fortitude Saving Throw</p>\n<p><strong>Maximum Duration</strong> 1 hour</p>\n<p><strong>Stage 1</strong> Fatigued (1 minute).</p>\n<p><strong>Stage 2</strong> Fatigued and Unconscious (1 minute).</p>",
      "collapsed": false
    },
    {
      "name": "Grab",
      "actions": 1,
      "traits": [],
      "description": "<p><details><summary>See rules...</summary>\n<p><p><strong>Requirements</strong> The monster's last action was a successful Strike that lists Grab in its damage entry, or the monster has a creature Grabbed or Restrained</p><hr /><p><strong>Effect</strong> If used after a Strike, the monster attempts to Grapple the creature using the body part it attacked with. This attempt neither applies nor counts toward the creature's multiple attack penalty.</p><p>The monster can instead use Grab and choose one creature it's grabbing or restraining with an appendage that has Grab to automatically extend that condition to the end of the monster's next turn.</p></p></details></p>",
      "collapsed": false
    }
