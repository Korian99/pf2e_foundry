  "offensiveAbilities": [
    {
      "name": "Claws from Below",
      "actions": 2,
      "traits": [],
      "description": "<p>The leshy crafter calls spiky roots that shoot up from the ground in the shape of Abyssal claws before retracting an instant later. This ability targets three 5-foot bursts within 30 feet. Each creature on the ground in an affected area takes 2d10 Piercing Damage damage (Basic DC 22 Reflex Saving Throw save). A creature takes the same amount of damage no matter how many overlapping bursts it's caught in.</p>",
      "collapsed": false
    },
    {
      "name": "Leech Materials",
      "actions": 2,
      "traits": [],
      "description": "<p><strong>Frequency</strong> once per minute</p>\n<hr />\n<p><strong>Effect</strong> The leshy crafter calls forth materials and natural energies from the surrounding area, creating a brief vortex of flora and debris. Each non-plant creature within 10 feet of the leshy crafter takes 3d6 Piercing Damage|options:area-damage]{3d6 piercing damage and 3d6 void damage}, with a Basic DC 22 Fortitude Saving Throw save.</p>\n<p>The debris cloud lasts until the leshy crafter's next turn; while the cloud lasts, all creatures within it become Concealed, and all creatures outside the cloud become concealed to creatures within it.</p>",
      "collapsed": false
    }
  ],
