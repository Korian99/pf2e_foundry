    {
      "name": "Feed on Fear",
      "actions": 1,
      "traits": [
        "concentrate"
      ],
      "description": "<p><strong>Requirements</strong> An enemy is being affected by a fear effect or Dying within 15 feet of the will-o'-wisp.</p><hr /><p><strong>Effect</strong> Urkhas feeds on the creature's terror. It regains 1d4 Healing Damage Hit Points, and if it has Gone Dark, its glow reignites.</p>\n<p>Urkhas can take this action only once per round.</p>",
      "collapsed": false
    },
    {
      "name": "Go Dark",
      "actions": 1,
      "traits": [
        "concentrate"
      ],
      "description": "<p>Urkhas extinguishes its glow, becoming Invisible. It can end this effect with another use of this action. If it uses its shock attack while invisible, the arc of electricity lets any observer determine its location, making the Urkhas only Hidden to all observers until it moves.</p>",
      "collapsed": false
    }
