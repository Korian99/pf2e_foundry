    {
      "name": "Camel Spit",
      "actions": null,
      "traits": [],
      "description": "<p>To drive away enemies, the camel spits the partially digested contents of its stomach at a creature within 10 feet.</p>\n<p>On a hit, the target is Dazzled for 1 round and must succeed at a DC 17 Fortitude Saving Throw save or become Sickened 1.</p>\n<p>The camel can't use its camel spit Strike again for 1d4 rounds.</p>",
      "collapsed": false
    },
    {
      "name": "Sand Stride",
      "actions": 2,
      "traits": [],
      "description": "<p>The camel Strides twice. It has a +5-foot circumstance bonus to its Speed during these Strides, ignoring difficult terrain caused by rubble, sand, and uneven ground made of earth and stone.</p>",
