  "offensiveAbilities": [
    {
      "name": "Dubious Shifting",
      "actions": 1,
      "traits": [
        "concentrate",
        "polymorph",
        "primal"
      ],
      "description": "<p>The zrukbat assumes the shape of any Small object or ornamentation, although the zrukbat's mimicked objects usually have unrealistic or suspicious quirks.</p>\n<p>This doesn't change the zrukbat's size but can alter their coloration and visual appearance.</p>\n<p>They have an automatic result of 23 on Deception checks and DCs to pass as the mimicked object.</p>",
      "collapsed": false
    },
    {
      "name": "Go for the Eyes",
      "actions": 2,
      "traits": [],
      "description": "<p>The zrukbat flies up to its Speed and makes a claw Strike at the end of its move.</p>\n<p>If the claw attack hits, the target must succeed on a DC 15 Fortitude Saving Throw saving throw or be Blinded for 1 round (or blinded for 1 minute on a critical failure). If the Strike was a critical hit, the target's save result is one degree of success worse.</p>",
      "collapsed": false
    }
