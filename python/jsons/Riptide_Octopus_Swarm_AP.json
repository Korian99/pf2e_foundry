    {
      "name": "Camouflage",
      "actions": null,
      "traits": [],
      "description": "<p>In wet environments like open water, tide pools, and even wet ship decks, a riptide octopus swarm can Hide and Sneak without cover or being Concealed.</p>",
      "collapsed": false
    },
    {
      "name": "Compression",
      "actions": null,
      "traits": [],
      "description": "<p>A riptide octopus swarm can move through a gap at least 6 inches wide without Squeezing and can Squeeze through a gap at least 1 inch wide.</p>",
      "collapsed": false
    },
    {
      "name": "Swarming Bites",
      "actions": 1,
      "traits": [],
      "description": "<p>Each enemy in the swarm's space takes 1d4 Piercing Damage damage and must attempt a Basic DC 16 Reflex Saving Throw save. A creature that fails its save takes 1d4 Persistent,piercing Damage damage as octopuses cling to and continue biting the creature.</p>",
      "collapsed": false
    }
