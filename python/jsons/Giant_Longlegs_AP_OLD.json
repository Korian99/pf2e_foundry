    {
      "name": "Noxious Spray",
      "actions": 2,
      "traits": [
        "olfactory",
        "poison"
      ],
      "description": "<p>The giant longlegs sprays a noxious chemical onto a single adjacent target, who must attempt a DC 20 Fortitude Saving Throw save. The giant longlegs can't use Noxious Spray for 1 minute.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected and temporarily immune to Noxious Spray for 1 minute.</p>\n<p><strong>Success</strong> The creature is unaffected.</p>\n<p><strong>Failure</strong> The creature is Sickened 1.</p>\n<p><strong>Critical Failure</strong> The creature is Sickened 2 and Enfeebled 1 for as long as they remain sickened.</p>",
