  "offensiveAbilities": [
    {
      "name": "Deafening Echo",
      "actions": null,
      "traits": [],
      "description": "<p>On a critical hit with an antler reverberation Strike, the target is Deafened for 1 minute.</p>",
      "collapsed": false
    },
    {
      "name": "Dominance Display",
      "actions": 2,
      "traits": [
        "auditory",
        "concentrate",
        "emotion",
        "fear",
        "mental",
        "primal"
      ],
      "description": "<p><strong>Frequency</strong> once per hour</p>\n<hr />\n<p><strong>Effect</strong> The arabuk postures and roars. All non-arabuk creatures within 30 feet must attempt a DC 20 Will Saving Throw save.</p><hr /><p><strong>Critical Success</strong> The creature is unaffected and is temporarily immune to this arabuk's Dominance Display for 24 hours.</p>\n<p><strong>Success</strong> The creature takes 2d8 Sonic Damage damage.</p>\n<p><strong>Failure</strong> The creature takes (2d8+9) Sonic Damage damage and is Frightened 1.</p>\n<p><strong>Critical Failure</strong> The creature takes (2d8+9) Sonic Damage damage and is Frightened 2.</p>",
      "collapsed": false
    },
    {
      "name": "Pounce",
      "actions": 1,
      "traits": [],
      "description": "<p>The arabuk Strides and makes a Strike at the end of that movement. If the arabuk began this action Hidden, it remains hidden until after this ability's Strike.</p>",
      "collapsed": false
    },
    {
      "name": "Reverb",
      "actions": -1,
      "traits": [
        "sonic"
      ],
      "description": "<p><strong>Trigger</strong> The arabuk hits a creature with an antler Strike</p>\n<hr />\n<p><strong>Effect</strong> The arabuk snarls, causing its antlers to reverberate and dealing an additional 1d6 Sonic Damage damage to the creature struck. This is in addition to the normal sonic damage from the antler Strike.</p>",
      "collapsed": false
    },
    {
      "name": "Snow Stride",
      "actions": null,
      "traits": [],
      "description": "<p>The arabuk ignores difficult terrain, greater difficult terrain, and uneven ground from non-magical ice and snow.</p>",
      "collapsed": false
    }
