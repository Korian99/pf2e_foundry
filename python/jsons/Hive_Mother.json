    {
      "name": "Armor-Rending Bite",
      "actions": 2,
      "traits": [],
      "description": "<p>The hive mother makes a mandibles Strike; if the Strike hits, the target's armor takes the damage and the acid damage bypasses the armor's Hardness.</p>",
      "collapsed": false
    },
    {
      "name": "Frenzy Pheromone",
      "actions": 2,
      "traits": [],
      "description": "<p>The hive mother unleashes a pheromone that causes all other ankhravs within a 100ft Emanation to become Quickened 1 until the start of the hive mother's next turn, and they can use the extra action only for Burrow, Stride, or Strike actions.</p>\n<p>The hive mother can't unleash the pheromone again for 1d4 rounds.</p>",
      "collapsed": false
    },
    {
      "name": "Spray Acid",
      "actions": 2,
      "traits": [
        "acid"
      ],
      "description": "<p>The hive mother spews acid in a 60ft Cone, dealing 8d6 Acid Damage|options:area-damage]{8d6 acid damage and 1d6 persistent acid damage} (Basic DC 26 Reflex Saving Throw save).</p>\n<p>It can't spew acid again for 1d4 rounds.</p>",
