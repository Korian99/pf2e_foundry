  "offensiveAbilities": [
    {
      "name": "Unleashed Familiar",
      "actions": null,
      "traits": [],
      "description": "<p>Norvix's familiar is a giant rat named Squelch. She can take her actions independently of Norvix's commands and has her statistics presented separately. She has the familiar of restored spirit ability, so when Norvix Casts or Sustains a hex, one willing creature within 15 feet of Squelch gains 2 temporary Hit Points until the start of his next turn.</p>",
      "collapsed": false
    }
  ],
  "spellcastingEntries": [
    {
      "name": "Divine Prepared Spells",
      "type": "prepared",
