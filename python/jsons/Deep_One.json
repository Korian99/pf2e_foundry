  "offensiveAbilities": [
    {
      "name": "Fervent Frenzy",
      "actions": 3,
      "traits": [],
      "description": "<p>The deep one makes two claw Strikes and one jaws Strike in any order. If the target creature is currently frightened by a deep one's Share Devotion ability, it's Off-Guard against these attacks. The deep one becomes Clumsy 1 until the start of their next turn.</p>",
      "collapsed": false
    },
    {
      "name": "Share Devotion",
      "actions": 2,
      "traits": [
        "concentrate",
        "emotion",
        "fear",
        "mental"
      ],
      "description": "<p>The deep one fills their enemies' minds with terrible hallucinations of the Outer Gods. All enemy creatures within a 30ft Type:emanation must attempt a DC 17 Will Saving Throw save; regardless of the result, a creature is temporarily immune to Share Devotion for 24 hours.</p><hr /><p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature is Frightened 1.</p>\n<p><strong>Failure</strong> The creature is Frightened 2.</p>\n<p><strong>Critical Failure</strong> As failure, plus Dazzled for as long as it's frightened.</p>",
      "collapsed": false
    }
  ],
