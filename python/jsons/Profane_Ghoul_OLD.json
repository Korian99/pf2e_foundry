  "offensiveAbilities": [
    {
      "name": "Ghoul Fever",
      "actions": null,
      "traits": [
        "disease"
      ],
      "description": "<p><strong>Saving Throw</strong> DC 29 Fortitude Saving Throw</p>\n<hr />\n<p><strong>Stage 1</strong> carrier with no ill effect (1 day)</p>\n<p><strong>Stage 2</strong> 2d6 Void Damage damage and regains half as many Hit Points from all healing (1 day)</p>\n<p><strong>Stage 3</strong> as stage 2 (1 day)</p>\n<p><strong>Stage 4</strong> 2d6 Void Damage damage and gains no benefit from healing (1 day)</p>\n<p><strong>Stage 5</strong> as stage 4 (1 day)</p>\n<p><strong>Stage 6</strong> dead, and rises as a Ghoul the next midnight.</p>",
      "collapsed": false
    },
    {
      "name": "Profane Paralysis",
      "actions": null,
      "traits": [
        "incapacitation",
        "occult"
      ],
      "description": "<p>Any living, non-elf creature hit by the profane ghoul's attack must attempt a DC 29 Fortitude Saving Throw save.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature is Slowed 1.</p>\n<p><strong>Failure</strong> The creature is Paralyzed. It can attempt a new save at the end of each of its turns, and the DC cumulatively decreases by 1 on each such save.</p>",
      "collapsed": false
    },
    {
      "name": "Profane Whispers",
      "actions": 2,
      "traits": [
        "auditory",
        "mental",
        "occult"
      ],
      "description": "<p>The ghoul whispers profane secrets of undeath. Living creatures within 10 feet of the ghoul take 2d8 Persistent,mental Damage damage. Those with ghoul fever must also succeed at a DC 29 Will Saving Throw save or have the disease advance one step. The profane ghoul can't use Profane Whispers again for 24 hours.</p>",
      "collapsed": false
    },
    {
      "name": "Scuttle",
      "actions": 1,
      "traits": [
        "move"
      ],
      "description": "<p>The profane ghoul crawls on all fours, moving up to half its Speed. This movement doesn't trigger reactions.</p>",
      "collapsed": false
    }
  ],
