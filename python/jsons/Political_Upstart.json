        "emotion",
        "linguistic",
        "mental"
      ],
      "description": "<p>The political upstart begins a rousing speech which they can Sustain up to 1 minute. Any creature within 30 feet that can hear the speech, must attempt a DC 17 Will Saving Throw save.</p>\n<p><strong>Success</strong> The creature is unaffected.</p>\n<p><strong>Failure</strong> The creature is Fascinated with the upstart for 1 round.</p>\n<p><strong>Critical Failure</strong> The creature is fascinated with the upstart as long as the speech lasts.</p>",
      "collapsed": false
    },
    {
      "name": "Fiery Rhetoric",
      "actions": 1,
      "traits": [
        "auditory",
        "concentrate",
        "emotion",
        "linguistic",
        "mental"
      ],
      "description": "<p>The upstart rattles off talking points at an enemy within 30 feet. The target takes a –2 status penalty to Perception and Will saves for 1 minute.</p>\n<p>Effect: Fiery Rhetoric</p>",
      "collapsed": false
    },
