  "offensiveAbilities": [
    {
      "name": "Consume Flesh",
      "actions": 1,
      "traits": [
        "manipulate"
      ],
      "description": "<p><strong>Requirements</strong> The esobok ghoul is adjacent to the corpse of a creature that died within the last hour.</p>\n<hr />\n<p><strong>Effect</strong> The ghoul devours a chunk of the corpse and regains 3d6 Healing Damage Hit Points.</p>\n<p>It can regain Hit Points from any given corpse only once.</p>",
      "collapsed": false
    },
    {
      "name": "Corrupted Touch",
      "actions": null,
      "traits": [],
      "description": "<p>An esobok ghoul's Strikes deal 1d6 Void Damage damage to living creatures. A creature critically hit by an esobok ghoul's Strike must attempt a DC 18 Fortitude Saving Throw save or become Drained 1 (Drained 2 on a critical failure) as rot spreads throughout their flesh.</p>",
      "collapsed": false
    },
    {
      "name": "Ghoul Fever",
      "actions": null,
      "traits": [
        "disease"
      ],
      "description": "<p><strong>Saving Throw</strong> DC 22 Fortitude Saving Throw</p>\n<p><strong>Stage 1</strong> carrier with no ill effect (1 day)</p>\n<p><strong>Stage 2</strong> 2d6 Void Damage damage and regains half as many Hit Points from all healing (1 day)</p>\n<p><strong>Stage 3</strong> as stage 2 (1 day)</p>\n<p><strong>Stage 4</strong> 2d6 Void Damage damage and gains no benefit from healing (1 day)</p>\n<p><strong>Stage 5</strong> as stage 4 (1 day)</p>\n<p><strong>Stage 6</strong> dead, and rises as a ghoul the next midnight.</p>",
      "collapsed": false
    },
    {
      "name": "Paralysis",
      "actions": null,
      "traits": [
        "incapacitation",
        "occult"
      ],
      "description": "<p>Any living, non-elf creature hit by a ghoul's attack must succeed at a DC 22 Fortitude Saving Throw save or become Paralyzed.</p>\n<p>It can attempt a new save at the end of each of its turns, and the DC cumulatively decreases by 1 on each such save.</p>",
      "collapsed": false
    },
    {
      "name": "Pounce",
      "actions": 1,
      "traits": [],
      "description": "<p>The esobok ghoul Strides and then makes a claw Strike. If it began this action hidden, it remains hidden until after the Strike.</p>",
      "collapsed": false
    }
  ],
