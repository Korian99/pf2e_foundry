  "offensiveAbilities": [
    {
      "name": "Destructive Harmonics",
      "actions": 2,
      "traits": [
        "auditory",
        "occult",
        "sonic"
      ],
      "description": "<p>The destrachan emits a harsh sonic cry that deals 9d6 Sonic Damage damage (Basic DC 26 Reflex Saving Throw save) in either a 60ft Cone or a 30ft Burst.</p>\n<p>It can't use Destructive Harmonics again for 1d4 rounds.</p>",
      "collapsed": false
    },
    {
      "name": "Painful Harmonics",
      "actions": 2,
      "traits": [
        "auditory",
        "incapacitation",
        "occult"
      ],
      "description": "<p>The destrachan emits a sonic cry in either a 60ft Cone or a 30ft Burst. This discordant ululation resonates along the nerves and bones of living creatures in the area, manifesting as waves of incapacitating pain washing over the victims. Each living creature in the area must attempt a DC 26 Fortitude Saving Throw save.</p>\n<p>The destrachan can't use Painful Harmonics again for 1d4 rounds.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature is Sickened 1 for 1 round.</p>\n<p><strong>Failure</strong> The creature is Deafened for 3 rounds and Stunned 2.</p>\n<p><strong>Critical Failure</strong> The creature is deafened for 1 minute and Stunned 3.</p>",
      "collapsed": false
    },
    {
      "name": "Shattering Harmonics",
      "actions": 2,
      "traits": [
        "occult",
        "sonic"
      ],
      "description": "<p>The destrachan focuses its harmonics against a single item within 60 feet that is made of crystal, metal, stone, or wood. The target object takes 7d8 Sonic Damage damage. If the item is attended, its bearer can attempt a Basic DC 26 Reflex Saving Throw save for the item.</p>\n<p>The destrachan can't use Shattering Harmonics again for 1d4 rounds.</p>",
      "collapsed": false
    }
  ],
  "spellcastingEntries": [],
  "recallKnowledge": "Occultism, DC 24"
