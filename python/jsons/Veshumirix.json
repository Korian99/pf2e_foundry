  "offensiveAbilities": [
    {
      "name": "Breath Weapon",
      "actions": 2,
      "traits": [
        "fire",
        "primal"
      ],
      "description": "<p>Veshumirix breathes a blast of magma that deals 9d6 Fire Damage|options:area-damage]{9d6 fire damage and 4d12 bludgeoning damage} in a 60ft Cone (Basic DC 42 Reflex Saving Throw save).</p>\n<p>He can't use Breath Weapon again for 1d4 rounds.</p>",
      "collapsed": false
    },
    {
      "name": "Draconic Frenzy",
      "actions": 2,
      "traits": [],
      "description": "<p>Veshumirix makes two claw Strikes and one horns Strike in any order.</p>",
      "collapsed": false
    },
    {
      "name": "Draconic Momentum",
      "actions": null,
      "traits": [],
      "description": "<p>Veshumirix recharges his Breath Weapon whenever he scores a critical hit with a Strike.</p>",
      "collapsed": false
    },
    {
      "name": "Magma Swim",
      "actions": null,
      "traits": [],
      "description": "<p>A magma dragon's swim Speed functions only when the dragon is swimming through magma or molten lava.</p>",
      "collapsed": false
    },
    {
      "name": "Volcanic Purge",
      "actions": 1,
      "traits": [],
      "description": "<p>If the next action Veshumirix uses is Breath Weapon, the magma clings to those it damages. Each creature that fails its save against the Breath Weapon takes 4d6 Persistent,fire Damage damage, and as long as it has this persistent fire damage, it also takes a -10-foot status penalty to its Speeds.</p>\n<p>Effect: Volcanic Purge</p>",
      "collapsed": false
    }
  ],
