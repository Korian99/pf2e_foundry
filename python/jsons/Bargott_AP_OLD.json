  "offensiveAbilities": [
    {
      "name": "Draining Impact",
      "actions": null,
      "traits": [
        "primal"
      ],
      "description": "<p>When Bargott hits a creature with his blighted branch Strike, the creature must attempt a DC 20 Fortitude Saving Throw save. Whatever the result, the creature is immune to Bargott's draining impact for 24 hours.</p>\n<p><strong>Success</strong> The creature is unaffected.</p>\n<p><strong>Failure</strong> The creature is Drained 1.</p>\n<p><strong>Critical Failure</strong> The creature is Drained 2.</p>",
      "collapsed": false
    },
    {
      "name": "Impart Anguish",
      "actions": 2,
      "traits": [
        "mental",
        "primal",
        "visual"
      ],
      "description": "<p>Bargott twists his face into a visage of utter agony, sharing his anguish with those who gaze upon him. Creatures in a 15ft Cone take 3d6 Mental Damage damage (Basic DC 19 Will Saving Throw). On a critically failed save, the creature is also Stupefied 1 for 1 round.</p>",
      "collapsed": false
    }
  ],
