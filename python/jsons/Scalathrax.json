    {
      "name": "Scalathrax Venom",
      "actions": null,
      "traits": [
        "poison"
      ],
      "description": "<p><strong>Saving Throw</strong> DC 21 Fortitude Saving Throw</p>\n<hr />\n<p><strong>Maximum Duration</strong> 6 rounds</p>\n<p><strong>Stage 1</strong> Clumsy 1 (1 round)</p>\n<p><strong>Stage 2</strong> clumsy 1 and Slowed 1 (1 round)</p>\n<p><strong>Stage 3</strong> clumsy 1 and Slowed 2 (1 round)</p>",
      "collapsed": false
    },
    {
      "name": "Spray Toxic Oil",
      "actions": 2,
      "traits": [
        "primal"
      ],
      "description": "<p>The scalathrax disgorges a gout of toxic oil from its mouth in a 15ft Cone. Creatures in the area must attempt a DC 21 Reflex Saving Throw save.</p>\n<p>The scalathrax can't use Toxic Oil Spray again for 1d4 rounds.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature takes 1d8 Poison Damage damage.</p>\n<p><strong>Failure</strong> The creature takes 2d8 Poison Damage damage. For 1 minute, the creature gains weakness to fire 5, and whenever the creature critically fails with an attack roll with a wielded weapon, it drops the weapon.</p>\n<p><strong>Critical Failure</strong> As failure, but 4d8 Poison Damage damage.</p>\n<p>Effect: Spray Toxic Oil</p>",
      "collapsed": false
    }
  ],
