    {
      "name": "Dirty Trick",
      "actions": 2,
      "traits": [
        "visual"
      ],
      "description": "<p><strong>Requirements</strong> A bandit disciple is holding a pouch of fine sand.</p>\n<hr />\n<p><strong>Effect</strong> The disciple Strides. If they end their movement adjacent to an enemy, they can make a  Target Perception check against that enemy's Perception DC.</p>\n<hr />\n<p><strong>Critical Success</strong> As success, and the enemy also takes 2 extra precision damage.</p>\n<p><strong>Success</strong> The enemy takes 1d4 Piercing Damage damage and is Blinded for 1 round.</p>\n<p><strong>Failure</strong> No effect.</p>\n<p><strong>Critical Failure</strong> The bandit disciple drops their pouch of fine sand, spilling and rendering it useless.</p>",
      "collapsed": false
    }
