  "defensiveAbilities": [
    {
      "name": "Consume Fear",
      "actions": -1,
      "traits": [
        "occult"
      ],
      "description": "<p><strong>Trigger</strong> A creature within 60 feet loses the frightened condition</p><hr /><p><strong>Effect</strong> The dragon feasts upon the fear that leaves the triggering creature's body, gaining 4d8 temporary Hit Points that last for 1 minute.</p>",
      "collapsed": false
    },
    {
      "name": "Frightful Presence",
      "actions": null,
      "traits": [
        "aura",
        "emotion",
        "fear",
        "mental"
      ],
      "description": "<p>60 feet DC 28 Will Saving Throw</p><hr /><p><details><summary>See rules...</summary>\n<p><p>A creature that first enters the area must attempt a Will save.</p>\n<p>Regardless of the result of the saving throw, the creature is temporarily immune to this monster's Frightful Presence for 1 minute.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected by the presence.</p>\n<p><strong>Success</strong> The creature is Frightened 1.</p>\n<p><strong>Failure</strong> The creature is Frightened 2.</p>\n<p><strong>Critical Failure</strong> The creature is Frightened 4.</p></p></details></p>",
      "collapsed": false
    },
    {
      "name": "Unbidden Thoughts",
      "actions": -1,
      "traits": [
        "emotion",
        "fear",
        "mental",
        "occult"
      ],
      "description": "<p><strong>Trigger</strong> The dragon is critically hit with a weapon or unarmed attack</p><hr /><p><strong>Effect</strong> The attacker's mind fills with visions of their worst fears that overwhelm their senses, and they must choose one of the following results: either the triggering attack becomes a normal success, or the critical hit is unaffected but the triggering creature becomes Frightened 2.</p>",
      "collapsed": false
    }
  ],
