      "actions": 2,
      "traits": [
        "mental",
        "occult",
        "sonic"
      ],
      "description": "<p>The dragon lets out a cacophonous sound made of every scream the dragon has drawn from a terrified enemy, dealing 8d6 Sonic Damage damage in a 30ft Type:cone (Basic DC 28 Will Saving Throw save). Creatures who fail their Will save must spend the first action of their next turn doing nothing but screaming. The dragon can't use Shrieking Breath again for 1d4 rounds.</p>",
      "collapsed": false
    }
